+                let (a, b) = (u * c3 - v * s3, v * c3 + u * s3);
+                let (up, back) = (a * s2, -(a * c2));
+                out.push([cx + (back * s1 - b * c1), cy + up, cz + (b * s1 + back * c1)]);
+            }
+        }
+    }
