+// ---- texture quality (resolution scale) for static textures ----------------
+// Effective scale in percent (100 = off). Written once in InitGL() on the main thread,
+// read from loader threads by PrescaleBitmap().
+static std::atomic<int> _StaticTexScalePercent(100);
+// true when the active static texture creator is the shrinking family (normal / scaled),
+// false for ETC2 / PVRTC (which do their own thing and ignore the quality option).
+static std::atomic<bool> _StaticTexShrinkable(false);
+// images this small (in a dimension) are never scaled: icons, cursors, 1px lines ...
+static const unsigned int TVP_TEXSCALE_KEEP_SIZE = 64;
+
+static unsigned int TVPScaleTexDim(unsigned int v, int percent)
+{
+	if (percent >= 100 || v <= TVP_TEXSCALE_KEEP_SIZE) return v;
+	if (percent == 50) return (v + 1) / 2; // keep exactly what the old "Quarter Pixel" mode produced
+	unsigned int r = (unsigned int)(((uint64_t)v * (unsigned int)percent + 50) / 100);
+	return r ? r : 1;
+}
+
+// Shrink a dimension so that it fits the max texture size (the historical behavior).
+static unsigned int TVPFitTexDim(unsigned int v, unsigned int maxsize)
+{
+	if (v <= maxsize) return v;
+	unsigned int n = (v + maxsize - 1) / maxsize;
+	return (v + n - 1) / n;
+}
+
+// Decide the stored size of a static texture. percent == 100 gives the same result as before
+// (only shrink to fit the max texture size). A lower percent never gives a larger result than 100%.
+static void TVPCalcStaticTexSize(unsigned int w, unsigned int h, int percent,
+	unsigned int &tw, unsigned int &th)
+{
+	tw = std::min(TVPFitTexDim(TVPScaleTexDim(w, percent), GetMaxTextureWidth()), TVPFitTexDim(w, GetMaxTextureWidth()));
+	th = std::min(TVPFitTexDim(TVPScaleTexDim(h, percent), GetMaxTextureHeight()), TVPFitTexDim(h, GetMaxTextureHeight()));
+}
