+        let l = Look::new(&LookCfg::default(), &env(0.3));
+        let q = sun_halo(&l, Vec3::new(0.0, 0.5, 0.75f32.sqrt()), Vec3::ZERO, 1000.0, 0.0).unwrap();
+        assert!((q.pos.length() - 920.0).abs() < 1e-2 && q.nofog && q.a > 0.0);
