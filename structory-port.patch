+    def __init__(s): s.b = bytearray()
+    def u8(s, v): s.b += struct.pack('<B', v)
+    def u16(s, v): s.b += struct.pack('<H', v)
+    def u32(s, v): s.b += struct.pack('<I', v)
+    def i16(s, v): s.b += struct.pack('<h', v)
