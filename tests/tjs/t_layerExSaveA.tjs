// t_layerExSaveA.tjs - LayerExSave.dll bagian A: getCropRect, getCropRectZero, getDiffRect, getDiffPixel,
// oozeColor, copyBlueToAlpha, isBlank, clearAlpha.   Spesifikasi: docs/spec/layerExSave_*.md
// STATUS: bahasa diperiksa di mesin TJS2 repo (tests/tjs_host); perilaku plugin BELUM dijalankan di perangkat. Piksel ARGB: (A<<24)|(R<<16)|(G<<8)|B.
// PERBAIKAN setelah log kedua: piksel/alfa lewat setPx/getPx (harness) -- setMainPixel/getMainPixel TIDAK membawa alfa.
// KANAL: spesifikasi menyebut isBlank/copyBlueToAlpha memakai 'byte 0 = biru', tetapi BTOA menemukan memori layer = R,G,B,A (biru = byte[2]).
// Jadi kanal yang sebenarnya dilihat tidak diasumsikan: probe per kanal (merah/hijau/biru) mengukurnya dan dicatat (CASE ...probe_*).
// `check` = invarian dari spesifikasi; `obs` = pengamatan untuk diff APK 1.3.9 vs fork (terutama CASE bertanda [BUG-BINER]).
function lsFlat(l, v) { fillFlat(l, v); }
function lsRectStr(d) { return (d === void) ? "void" : (d.x + "," + d.y + "," + d.w + "," + d.h); }

// Warna 24-bit v pada kanal ch (0=R,1=G,2=B) dengan alfa a, sebagai ARGB konvensional.
function lsChan(ch, v, a) { return ((a & 255) << 24) | ((v & 255) << (16 - 8 * ch)); }
// Bandingkan hasil tulis-mentah plugin (RGB 24-bit px) dengan warna yang diminta. "konvensional" = sama; "terbalik" = R/B tertukar; selain itu "lain".
function lsOrder(px, want) { px = px & 0xFFFFFF; return (px == (want & 0xFFFFFF)) ? "konvensional" : (px == rbswap(want)) ? "terbalik_RB" : "lain"; }

function run_layerExSaveA()
{
	tlog("== layerExSave A (RENDERER=" + RENDERER + ")");
	Plugins.link("LayerExSave.dll");
	var names = [ "getCropRect", "getCropRectZero", "getDiffRect", "getDiffPixel", "oozeColor", "copyBlueToAlpha", "isBlank", "clearAlpha" ];
	var nada = 0;
	for (var i = 0; i < names.count; i++) { var ok = hasMember(Layer, names[i]); if (!ok) nada++; check("terdaftar " + names[i], ok); }
	if (nada == names.count) {
		// Log kedua: semua 8 hilang + ERROR 'Member getCropRect does not exist'. Penyebab paling mungkin: APK dibangun TANPA layerExSave.cpp
		// (CMake file(GLOB) tidak dikonfigurasi ulang) -- bukan galat logika plugin. Berhenti di sini agar tidak berantai jadi ERROR.
		check("LayerExSave.dll termuat (APK harus dibangun dari pohon yang berisi src/plugins/layerExSave.cpp; konfigurasi ulang CMake)", false);
		return;
	}

	// ---- getCropRect / getCropRectZero ----
	var a = mk(6, 5, ltAlpha, 1, true); lsFlat(a, 0);
	check("getCropRect kosong -> void", a.getCropRect() === void);
	check("getCropRectZero kosong -> void", a.getCropRectZero() === void);
	setPx(a, 2, 1, 0x01000000); setPx(a, 4, 3, 0x80102030);
	var r = a.getCropRect();
	obs("getCropRect.dua_titik", lsRectStr(r));
	check("getCropRect rect (2,1,3,3)", r !== void && r.x == 2 && r.y == 1 && r.w == 3 && r.h == 3);
	lsFlat(a, 0); setPx(a, 0, 0, 0x00000001);                 // alfa 0, biru 1
	check("getCropRect abaikan piksel beralfa 0", a.getCropRect() === void);
	r = a.getCropRectZero();
	check("getCropRectZero hitung piksel != 0 walau alfa 0", r !== void && r.x == 0 && r.y == 0 && r.w == 1 && r.h == 1);
	obs("getCropRect.tipe_hasil", (a.getCropRect() === void) ? "void" : "objek");

	// ---- getDiffRect ----
	var b = mk(6, 6, ltAlpha, 2, true), c = mk(6, 6, ltAlpha, 2, true);
	lsFlat(b, 0); lsFlat(c, 0);
	check("getDiffRect sama -> void", b.getDiffRect(c) === void);
	setPx(c, 1, 2, 0xFF112233); setPx(c, 3, 4, 0xFF445566);
	r = b.getDiffRect(c);
	obs("getDiffRect.dua_titik", lsRectStr(r));
	check("getDiffRect rect (1,2,3,3)", r !== void && r.x == 1 && r.y == 2 && r.w == 3 && r.h == 3);
	// alfa 0: warna diabaikan
	lsFlat(b, 0x00112233); lsFlat(c, 0x00998877);
	check("getDiffRect warna beda tapi alfa 0 -> void", b.getDiffRect(c) === void);
	// [BUG-BINER] beda di (2,0) dan (0,5): rect benar (0,0,3,6); biner memindai baris-bawah dari kolom KANAN -> (0,0,3,1)
	lsFlat(b, 0); lsFlat(c, 0); setPx(c, 2, 0, 0xFF000000); setPx(c, 0, 5, 0xFF000000);
	obs("getDiffRect.BUG_BINER (benar=0,0,3,6; biner=0,0,3,1)", lsRectStr(b.getDiffRect(c)));
	// ukuran beda
	var d5 = mk(6, 5, ltAlpha, 3, true);
	var rr = callm(b, "getDiffRect", [ d5 ]);
	obs("getDiffRect.ukuran_beda", rr);
	check("getDiffRect ukuran beda melempar", rr != "ok");
	obs("getDiffRect.tanpa_param", callm(b, "getDiffRect", [ ]));

	// ---- getDiffPixel ----
	var p = mk(4, 3, ltAlpha, 4, true), q = mk(4, 3, ltAlpha, 4, true);
	lsFlat(p, 0xFF102030); lsFlat(q, 0xFF102030);
	setPx(q, 0, 0, 0xFF000001); setPx(q, 3, 2, 0x80102030);
	var n = p.getDiffPixel(q);
	check("getDiffPixel hitung beda = 2", n == 2);
	var s = mk(4, 3, ltAlpha, 4, true); lsFlat(s, 0xFF102030);
	n = s.getDiffPixel(q, 0x11111111, 0x22222222);                    // this=s ditulis: sama -> 0x11111111, beda -> 0x22222222
	check("getDiffPixel nilai kembali", n == 2);
	check("getDiffPixel tulis beda", getPx(s, 0, 0) == 0x22222222 && getPx(s, 3, 2) == 0x22222222);
	check("getDiffPixel tulis sama", getPx(s, 1, 1) == 0x11111111);
	var s2 = mk(4, 3, ltAlpha, 4, true); lsFlat(s2, 0xFF102030);
	s2.getDiffPixel(q, void, 0x33333333);                              // void = tidak diberikan
	check("getDiffPixel void pada 'same' = tak tulis", getPx(s2, 1, 1) == 0xFF102030 && getPx(s2, 0, 0) == 0x33333333);
	obs("getDiffPixel.ukuran_beda", callm(s, "getDiffPixel", [ d5 ]));

	// ---- oozeColor(level, threshold=1, color=0) ----
	var o = mk(4, 1, ltAlpha, 5, true);
	setPx(o, 0, 0, 0x00112233); setPx(o, 1, 0, 0x01112233); setPx(o, 2, 0, 0xFE112233); setPx(o, 3, 0, 0xFF112233);
	o.oozeColor(1);
	obs("oozeColor.default hash", hashLayer(o));
	check("oozeColor default: alfa 0 -> warna 0, alfa tetap", getPx(o, 0, 0) == 0x00000000 && getPx(o, 1, 0) == 0x01112233);
	setPx(o, 0, 0, 0x00112233); setPx(o, 2, 0, 0xFE112233);
	o.oozeColor(3, 0xFF, 0xAABBCC);
	// Plugin menulis byte0=color&0xFF, byte1=color>>8, byte2=color>>16 (urutan B,G,R menurut spesifikasi). Jika memori layer R,G,B,A,
	// hasil terbaca terbalik R/B terhadap `color`; itu perilaku biner (ditiru), jadi CHECK menerima kedua urutan dan CASE mencatatnya.
	obs("oozeColor.urutan_warna", lsOrder(getPx(o, 2, 0), 0xAABBCC));
	check("oozeColor ambang 255: alfa<255 diganti (warna konvensional ATAU R/B terbalik), alfa tak berubah",
		pixelAlpha(o, 2, 0) == 0xFE && lsOrder(getPx(o, 2, 0), 0xAABBCC) != "lain" && getPx(o, 3, 0) == 0xFF112233);
	var lv = mk(2, 1, ltAlpha, 5, true);
	check("oozeColor level 0 melempar", callm(lv, "oozeColor", [ 0 ]) != "ok");
	check("oozeColor tanpa param -> galat", callm(lv, "oozeColor", [ ]) != "ok");
	var o1 = mk(5, 4, ltAlpha, 6, true), o9 = mk(5, 4, ltAlpha, 6, true);
	o1.oozeColor(1, 3, 0x123456); o9.oozeColor(9, 3, 0x123456);
	check("oozeColor level tidak berpengaruh pada piksel", hashLayer(o1) == hashLayer(o9));

	// ---- kanal yang dilihat copyBlueToAlpha / isBlank (diukur, bukan diasumsikan) ----
	// Spesifikasi: 'byte 0 piksel = biru'. Memori layer fork R,G,B,A (temuan BTOA) -> byte 0 = MERAH. Probe: tiap kanal diberi nilai 0xAA sendirian.
	var cbCh = -1, cbCnt = 0, ibCh = -1, ibCnt = 0, ch;
	for (ch = 0; ch < 3; ch++) {
		var pn = "RGB".charAt(ch);
		var ps = mk(3, 2, ltAlpha, 7, true), pd = mk(3, 2, ltAlpha, 8, true);
		lsFlat(ps, lsChan(ch, 0xAA, 0xFF)); lsFlat(pd, 0x11223344);
		pd.copyBlueToAlpha(ps);
		var got = pixelAlpha(pd, 1, 1);
		obs("copyBlueToAlpha.probe_" + pn, "alfa_tujuan=" + got);
		if (got == 0xAA) { cbCh = ch; cbCnt++; }
		var pb = mk(3, 2, ltAlpha, 9, true); lsFlat(pb, lsChan(ch, 0xAA, 0xFF));
		var ib = pb.isBlank(0, 0, 3, 2);
		obs("isBlank.probe_" + pn, ib);
		if (ib == 0) { ibCh = ch; ibCnt++; }
	}
	var pz = mk(3, 2, ltAlpha, 9, true); lsFlat(pz, 0xFF000000);
	check("isBlank: alfa saja (RGB nol) -> 1 (alfa tidak diperiksa)", pz.isBlank(0, 0, 3, 2) == 1);
	check("copyBlueToAlpha membaca tepat SATU kanal warna", cbCnt == 1);
	check("isBlank membaca tepat SATU kanal warna", ibCnt == 1);
	check("isBlank dan copyBlueToAlpha memakai kanal yang sama (keduanya byte 0 menurut spesifikasi)", cbCnt == 1 && ibCnt == 1 && cbCh == ibCh);
	obs("layerExSave.kanal_byte0", (cbCnt == 1) ? ("RGB".charAt(cbCh) + (cbCh == 2 ? " (biru konvensional)" : " (BUKAN biru: nama method menyesatkan di layout R,G,B,A)")) : "tak_tentu");
	var bch = (cbCnt == 1) ? cbCh : 2;       // kanal 'biru' menurut biner; dipakai untuk uji wilayah di bawah

	// ---- copyBlueToAlpha: wilayah & isi ----
	var sb = mk(3, 3, ltAlpha, 7, true), db = mk(4, 2, ltAlpha, 8, true);
	lsFlat(sb, lsChan(bch, 0xAA, 0xFF)); lsFlat(db, 0x11223344);
	db.copyBlueToAlpha(sb);                                            // wilayah min(3,4) x min(3,2)
	check("copyBlueToAlpha: alfa := kanal sumber (di wilayah tumpang tindih), warna tujuan tak berubah", getPx(db, 0, 0) == 0xAA223344 && getPx(db, 2, 1) == 0xAA223344);
	check("copyBlueToAlpha: di luar wilayah tak berubah", getPx(db, 3, 0) == 0x11223344 && getPx(db, 3, 1) == 0x11223344);
	obs("copyBlueToAlpha.bukan_layer", callm(db, "copyBlueToAlpha", [ 5 ]));
	if (RUN_UNSAFE_CASES) obs("copyBlueToAlpha.tanpa_param [UNSAFE di biner]", callm(db, "copyBlueToAlpha", [ ]));

	// ---- isBlank(x, y, w, h): semua byte-0 nol = blank ----
	var k = mk(5, 4, ltAlpha, 9, true); lsFlat(k, 0xFF000000);   // alfa penuh, RGB nol
	check("isBlank RGB nol (alfa penuh) -> 1", k.isBlank(0, 0, 5, 4) == 1);
	setPx(k, 3, 2, lsChan(bch, 1, 0));                             // satu piksel dengan kanal terukur = 1
	check("isBlank ada kanal terukur -> 0", k.isBlank(0, 0, 5, 4) == 0 && k.isBlank(3, 2, 1, 1) == 0);
	check("isBlank rect tanpa piksel itu -> 1", k.isBlank(0, 0, 3, 4) == 1);
	check("isBlank lebar/tinggi 0 -> 1", k.isBlank(0, 0, 0, 4) == 1 && k.isBlank(0, 0, 5, 0) == 1);
	obs("isBlank.di_luar_layer", callm(k, "isBlank", [ 4, 0, 2, 1 ]));
	check("isBlank di luar layer melempar", callm(k, "isBlank", [ 4, 0, 2, 1 ]) != "ok");
	check("isBlank x negatif melempar", callm(k, "isBlank", [ -1, 0, 1, 1 ]) != "ok");
	obs("isBlank.tinggi_negatif", callm(k, "isBlank", [ 0, 0, 1, -1 ]));
	check("isBlank < 4 param -> galat", callm(k, "isBlank", [ 0, 0, 1 ]) != "ok");

	// ---- clearAlpha(threshold=0, color=0) ----
	var z = mk(3, 1, ltAlpha, 10, true);
	setPx(z, 0, 0, 0x00112233); setPx(z, 1, 0, 0x05112233); setPx(z, 2, 0, 0xFF112233);
	z.clearAlpha();
	check("clearAlpha default: hanya alfa 0 -> 0x00000000", getPx(z, 0, 0) == 0 && getPx(z, 1, 0) == 0x05112233);
	z.clearAlpha(5, 0xFF123456);                                       // alfa <= 5 -> piksel = 0x00123456 (bit atas warna dibuang)
	obs("clearAlpha.urutan_warna", lsOrder(getPx(z, 1, 0), 0x123456));
	check("clearAlpha ambang 5, warna (konvensional ATAU R/B terbalik), alfa jadi 0", pixelAlpha(z, 1, 0) == 0 && lsOrder(getPx(z, 1, 0), 0x123456) != "lain" && getPx(z, 2, 0) == 0xFF112233);
	z.clearAlpha(-1, 0xABCDEF);
	check("clearAlpha ambang negatif: tak ada yang berubah", getPx(z, 2, 0) == 0xFF112233);
	z.clearAlpha(255, 0x010203);
	obs("clearAlpha.255", hashLayer(z));
	dropAll();
}
