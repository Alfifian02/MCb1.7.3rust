// t_stretchCopyAA.tjs - layerExAreaAverage.dll (alias Layer.stretchCopyAA = Layer.stretchCopy)
// Spesifikasi: docs/spec/layerExAreaAverage_stretchCopyAA.md
function run_stretchCopyAA()
{
	tlog("== stretchCopyAA");
	// Waktu eksekusi: apakah ada SEBELUM Plugins.link? (pengamatan; fork: dijalankan saat link, lihat docs/spec/plugin_registrasi.md)
	obs("stretchCopyAA.ada_sebelum_link", (hasMember(Layer, "stretchCopyAA") ? "ada" : "tidak_ada"));
	Plugins.link("layerExAreaAverage.dll");
	obs("stretchCopyAA.ada_setelah_link", (hasMember(Layer, "stretchCopyAA") ? "ada" : "tidak_ada"));
	check("stretchCopyAA === stretchCopy (alias)", Layer.stretchCopyAA === Layer.stretchCopy);

	// Piksel: AA vs stretchCopy harus identik (alias), untuk dua mode skala.
	var modes = [ [ "default", void ], [ "linear", stLinear ] ];
	for (var i = 0; i < modes.count; i++) {
		var src = mk(16, 16, ltAlpha, 1, true);
		var a = mk(8, 8, ltAlpha, 2, true);
		var b = mk(8, 8, ltAlpha, 2, true);
		if (modes[i][1] === void) {
			a.stretchCopyAA(0, 0, 8, 8, src, 0, 0, 16, 16);
			b.stretchCopy(0, 0, 8, 8, src, 0, 0, 16, 16);
		} else {
			a.stretchCopyAA(0, 0, 8, 8, src, 0, 0, 16, 16, modes[i][1]);
			b.stretchCopy(0, 0, 8, 8, src, 0, 0, 16, 16, modes[i][1]);
		}
		obs("stretchCopyAA.hash." + modes[i][0], hashLayer(a));
		check("stretchCopyAA piksel == stretchCopy (" + modes[i][0] + ")", hashLayer(a) == hashLayer(b));
	}
	// Tautan ulang tidak boleh error.
	obs("stretchCopyAA.link_ulang", callm(Plugins, "link", [ "layerExAreaAverage.dll" ]));
	dropAll();
}
