	// ---- layerExAlpha S9 (semantik minimal dari docs/spec + layerExAlphaCore.hpp: ride7/ride8/border_inner). Hanya agar CHECK skrip ikut dieksekusi. ----
	function _isLayer(o) { return typeof o == "Object" && o._px !== void; }
	function MaskImageRideRect7(img, mask, a, b) {
		if (b === void) throw new Exception("Invalid argument count");
		if (!_isLayer(img) || !_isLayer(mask)) throw new Exception("Not Layer");
		if (b < 1) throw new Exception("Invalid argument");
		if (img._w != _w || img._h != _h || mask._w != _w || mask._h != _h) return;
		var lo = (a - b < 0) ? 0 : (a - b + 1); if (lo > 255) lo = 255;
		var hi = a + b; if (hi < 0) hi = 0; if (hi > 255) hi = 255;
		var n = 2 * b - 1;
