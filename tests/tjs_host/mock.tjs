		for (var y = 0; y < h; y++) for (var x = 0; x < w; x++) _px[y * _w + x] = (((src._px[y * src._w + x] & 0xFF) << 24) | (_px[y * _w + x] & 0xFFFFFF));
	}
	function isBlank(x, y, w, h) {
		if (h === void) throw new Exception("badparamcount");
		if (w == 0 || h == 0) return 1;
		if (x < 0 || y < 0 || w < 0 || h < 0 || x + w > _w || y + h > _h) throw new Exception("invalid param");
		for (var j = y; j < y + h; j++) for (var i = x; i < x + w; i++) if ((_px[j * _w + i] & 0xFF) != 0) return 0;
		return 1;
	}
	function clearAlpha(threshold, color) {
		if (threshold === void) threshold = 0; if (color === void) color = 0;
		for (var i = 0; i < _w * _h; i++) { var a = ((_px[i] & 0xFFFFFFFF) >> 24) & 0xFF; if (a <= threshold) _px[i] = (color & 0xFFFFFF); }
	}
