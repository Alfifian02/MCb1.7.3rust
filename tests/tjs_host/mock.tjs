		_px[y * _w + x] = (_px[y * _w + x] & 0xFF000000) | c;
	}
	function getMaskPixel(x, y) { if (x < 0 || y < 0 || x >= _w || y >= _h) throw new Exception("out of rectangle"); return (_px[y * _w + x] >> 24) & 0xFF; }
	function setMaskPixel(x, y, m) { if (x < 0 || y < 0 || x >= _w || y >= _h) throw new Exception("out of rectangle"); _px[y * _w + x] = ((m & 0xFF) << 24) | (_px[y * _w + x] & 0xFFFFFF); }
	function copyRect(dx, dy, src, sx, sy, w, h) { }
	function stretchCopy(dx, dy, dw, dh, src, sx, sy, sw, sh, t) { }
	// ---- semantik minimal sesuai spesifikasi (hanya untuk menguji logika CHECK, BUKAN perilaku plugin sebenarnya) ----
	function shrinkCopyFast(src, hs, vs) {
