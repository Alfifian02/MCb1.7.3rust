	}

	// ---- LayerExSave bagian A: tiruan minimal HANYA agar semua jalur skrip tereksekusi (diturunkan dari ekspektasi tes, bukan dari plugin) ----
	function _cropRect(zero) {
		var x0 = _w, y0 = _h, x1 = -1, y1 = -1;
		for (var y = 0; y < _h; y++) for (var x = 0; x < _w; x++) {
