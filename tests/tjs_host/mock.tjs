		setImageSize(ew, eh);
		for (var y = 0; y < eh; y++) for (var x = 0; x < ew; x++) _px[y * _w + x] = 0xFF000000 | (src._px[(y * evs) * src._w + x * hs] & 0xFFFFFF);
	}
	function shrinkCopy(dx, dy, dw, dh, src, sx, sy, sw, sh) {
