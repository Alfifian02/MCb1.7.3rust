class MockPlugins {
	function link(name) {
		var n = name.toLowerCase();
		var p = n.indexOf("/"); while (p >= 0) { n = n.substring(p + 1); p = n.indexOf("/"); }
		var ms = MOCK_MODULES[n];
		if (ms === void) return;                       // fork: modul tak dikenal diabaikan tanpa galat
		for (var i = 0; i < ms.count; i++) { if (MOCK_REAL.find(ms[i]) < 0) Layer[ms[i]] = MOCK_STUB; if (MOCK_NAMES.find(ms[i]) < 0) MOCK_NAMES.add(ms[i]); }
	}
}
var Plugins = new MockPlugins();
class MockDebug { function message(s) { } function startLogToFile(b) { } }
var Debug = new MockDebug();

