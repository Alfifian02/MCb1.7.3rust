			if (hit) { if (x < x0) x0 = x; if (y < y0) y0 = y; if (x > x1) x1 = x; if (y > y1) y1 = y; }
		}
		if (x1 < 0) return void;
		return %[ x: x0, y: y0, w: x1 - x0 + 1, h: y1 - y0 + 1 ];
	}
	function getCropRect() { return _cropRect(false); }
	function getCropRectZero() { return _cropRect(true); }
	function _same(a, b) { a = a & 0xFFFFFFFF; b = b & 0xFFFFFFFF; if (((a >> 24) & 0xFF) == 0 && ((b >> 24) & 0xFF) == 0) return true; return a == b; }
	function getDiffRect(o) {
		if (o === void) throw new Exception("badparamcount");
		if (o._w != _w || o._h != _h) throw new Exception("invalid param");
		var x0 = _w, y0 = _h, x1 = -1, y1 = -1;
		for (var y = 0; y < _h; y++) for (var x = 0; x < _w; x++) if (!_same(_px[y * _w + x], o._px[y * _w + x])) { if (x < x0) x0 = x; if (y < y0) y0 = y; if (x > x1) x1 = x; if (y > y1) y1 = y; }
		if (x1 < 0) return void;
		return %[ x: x0, y: y0, w: x1 - x0 + 1, h: y1 - y0 + 1 ];
	}
	function getDiffPixel(o, same, diff) {
		if (o === void) throw new Exception("badparamcount");
		if (o._w != _w || o._h != _h) throw new Exception("invalid param");
		var n = 0;
		for (var y = 0; y < _h; y++) for (var x = 0; x < _w; x++) {
			var d = (_px[y * _w + x] & 0xFFFFFFFF) != (o._px[y * _w + x] & 0xFFFFFFFF);
			if (d) { n++; if (diff !== void) _px[y * _w + x] = diff; } else if (same !== void) _px[y * _w + x] = same;
		}
		return n;
	}
	function oozeColor(level, threshold, color) {
		if (level === void) throw new Exception("badparamcount");
		if (level < 1) throw new Exception("invalid param");
		if (threshold === void) threshold = 1; if (color === void) color = 0;
		for (var i = 0; i < _w * _h; i++) { var v = _px[i] & 0xFFFFFFFF; var a = (v >> 24) & 0xFF; if (a < threshold) _px[i] = (a << 24) | (color & 0xFFFFFF); }
	}
	function copyBlueToAlpha(src) {
