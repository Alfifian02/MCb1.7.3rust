			if (lo > m) continue;
			if (hi <= m) { _px[i] = _px[i] & 0x00FFFFFF; continue; }
			var idx = m - lo, t;
			if (idx < b - 1) t = (idx + 1) / b; else if (idx == b - 1) t = 1.0; else t = (n - idx) / b;
