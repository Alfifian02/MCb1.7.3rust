+/// `BlockFire.func_263_h`: some neighbour burns.
+fn next_to_fuel(w: &ChunkManager, x: i32, y: i32, z: i32) -> bool {
+    SIDES.iter().any(|&(a, b, c)| burn_rate(bid(w, x + a, y + b, z + c)).0 > 0)
