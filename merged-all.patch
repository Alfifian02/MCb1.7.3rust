+    /// Stone below y = 60, water in 60..64, air above: a pond 64 deep in x and z.
+    fn pond(x: i32, y: i32, z: i32) -> Option<u8> {
+        if !(0..64).contains(&x) || !(0..64).contains(&z) {
+            return Some(1);
+        }
