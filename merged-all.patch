+            let (x0, z0) = (x - dx * k - 1, z - dz * k - 1);
+            (x0..=x0 + 2).flat_map(move |a| (z0..=z0 + 2).map(move |b| (a, b)))
+        })
+        .find(|&(a, b)| normal_cube(get(a, y - 1, b)) && get(a, y, b) == 0 && get(a, y + 1, b) == 0)
+        .map(|(a, b)| (a, y, b))
+}
