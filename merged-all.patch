+pub fn wake_cell(get: &dyn Fn(i32, i32, i32) -> u8, (x, y, z): (i32, i32, i32), meta: u8) -> Option<(i32, i32, i32)> {
+    let (dx, dz) = BED_DIR[(meta & 3) as usize];
+    (0..=1)
