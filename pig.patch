+        ([-2.0, 0.0, -2.0], [4.0, 6.0, 4.0], [3.0, 18.0, 7.0], swing(std::f32::consts::PI)),         // leg2
+        ([-2.0, 0.0, -2.0], [4.0, 6.0, 4.0], [-3.0, 18.0, -5.0], swing(std::f32::consts::PI)),       // leg3
+        ([-2.0, 0.0, -2.0], [4.0, 6.0, 4.0], [3.0, 18.0, -5.0], swing(0.0)),                         // leg4
