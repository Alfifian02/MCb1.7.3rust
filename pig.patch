+    pub fn push_tooltip(out: &mut Vec<HudVertex>, x: f32, y: f32, k: f32, s: &str) {
+        Self::push_quad(out, x, y, (Self::text_width(s) as f32 + 6.0) * k, 14.0 * k, [0.0, 0.0, 0.0, 0.75]);
+        Self::push_text(out, x + 3.0 * k, y + 3.0 * k, k, s, [1.0; 4]);
+    }
