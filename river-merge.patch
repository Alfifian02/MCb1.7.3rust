+    /// The lowest water surface among every segment whose channel holds the point (clearance <= 0), `None` if no channel does.
+    /// `nearest` picks ONE segment, so where two channels overlap (a confluence, the inside of a bend, a braid) the column took the level
+    /// of whichever centre line was nearer and the border between the two levels ran along that arbitrary diagonal: a sawtooth of water
+    /// standing at different heights side by side. One level per column removes the border; the lowest wins so water is never held
+    /// above a neighbouring channel's floor.
+    fn channel_grade(&self, x: f64, z: f64) -> Option<f64> {
+        let b = ((x / BUCKET as f64).floor() as i32, (z / BUCKET as f64).floor() as i32);
+        let mut low: Option<f64> = None;
+        for &i in self.index.get(&b)? {
+            let s = &self.segs[i as usize];
+            let (d, t) = seg_distance(s, x, z);
+            if d <= s.w1 + (s.w2 - s.w1) * t {
+                let g = s.y1 + (s.y2 - s.y1) * t;
+                low = Some(low.map_or(g, |l: f64| l.min(g)));
+            }
+        }
+        low
+    }
