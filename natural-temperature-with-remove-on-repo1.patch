-fn category(out: ItemStack) -> Cat {
-    if REDSTONE.contains(&out.id) {
-        return Cat::Redstone;
-    }
-    match pack::category(out.id) {
-        pack::Cat::Tools => Cat::Tools,
-        pack::Cat::Food => Cat::Food,
-        _ if out.id < 256 => Cat::Blocks,
-        _ => Cat::Other,
-    }
-}
