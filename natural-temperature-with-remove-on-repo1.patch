-    quad(v, [i[0], i[1], i[2], u.max(1.0)], PLATE_HI);
-    text_in_o(v, r[0] + r[2] * 0.5, r[1] + (r[3] - 8.0 * tk) * 0.5, tk, (r[0] + 2.0 * u, r[0] + r[2] - 2.0 * u), text, WHITE, (u * 0.34).round().max(1.0));
