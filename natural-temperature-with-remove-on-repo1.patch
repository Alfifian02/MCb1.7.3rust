-impl Cat {
-    pub fn label(self) -> &'static str {
-        match self {
-            Cat::Tools => "Tools & gear",
-            Cat::Food => "Food",
-            Cat::Blocks => "Blocks",
-            Cat::Redstone => "Redstone & rails",
-            Cat::Other => "Other",
-            Cat::Furnace => "Furnace",
-        }
