-pub const CARRY_SECS: f32 = 0.35;
-
-#[derive(Clone, Copy, PartialEq, Eq, Debug)]
-pub enum Step {
-    Idle,
-    /// Fully spread: the screen may open.
-    Open,
-    /// Fully rolled up: remove it.
-    Gone,
-}
