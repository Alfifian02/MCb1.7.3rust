-/// A grey button with a black outline: `state` 0 disabled, 1 normal, 2 on; the label is white with a black edge.
-fn btn(v: &mut Vec<HudVertex>, r: [f32; 4], (tk, u): (f32, f32), text: &str, state: u8) {
