-use crate::render::hud::sprites::sat as art;
-
-const WHITE: [f32; 4] = [1.0; 4];
-const BLACK: [f32; 4] = [0.0, 0.0, 0.0, 1.0];
-const SELECTED: [f32; 4] = [0.95, 0.85, 0.1, 1.0];
