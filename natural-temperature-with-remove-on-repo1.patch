-/// Every recipe and smelting, category by category, each by result id and damage.
-pub fn entries() -> &'static [Entry] {
-    static E: OnceLock<Vec<Entry>> = OnceLock::new();
-    E.get_or_init(|| {
-        let mut v: Vec<Entry> = craft::recipes()
