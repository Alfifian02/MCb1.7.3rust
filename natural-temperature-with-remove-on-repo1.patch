-    /// Boxes (min, max in world coordinates) to draw: the cloth from the near edge to the roll, and the roll that shrinks as it
-    /// travels away from the player (gone when spread).
-    pub fn boxes(&self) -> Vec<([f32; 3], [f32; 3])> {
