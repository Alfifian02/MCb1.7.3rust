-/// `FirstPersonCamera::forward`.
-fn forward(yaw: f32, pitch: f32) -> Vec3 {
-    let ((sy, cy), (sp, cp)) = (yaw.sin_cos(), pitch.sin_cos());
-    Vec3::new(sy * cp, -sp, -cy * cp)
