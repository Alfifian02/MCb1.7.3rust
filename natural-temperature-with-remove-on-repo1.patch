-        for (n, (i, j)) in [(0.01, 0.01), (0.5, 0.01), (0.99, 0.01), (0.01, 0.5), (0.5, 0.5), (0.99, 0.5), (0.01, 0.99), (0.5, 0.99), (0.99, 0.99)].into_iter().enumerate() {
