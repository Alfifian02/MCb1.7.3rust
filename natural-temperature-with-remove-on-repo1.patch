-            1 => {
-                self.t += dt / SPREAD_SECS;
-                if self.t >= 1.0 {
-                    (self.t, self.dir) = (1.0, 0);
-                    return Step::Open;
-                }
-            }
-            -1 => {
-                self.t -= dt / ROLL_SECS;
-                if self.t <= 0.0 {
-                    return Step::Gone;
-                }
-            }
-            _ => {}
-        }
-        Step::Idle
-    }
