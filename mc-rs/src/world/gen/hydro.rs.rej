+
+/// The bed's y of a channel column: the full depth on the deepest line, `BED_EDGE` of it at the edge, never less than one block of water.
+/// The deepest line sits on the centre line of a straight reach and moves toward the outer bank in a bend (the water of a bend digs the
+/// outside; `HydraulicGeometry`'s bed side, `RiverEngine`'s bend / lateral), by `BEND_SHIFT` of the half width at a full bend.
+fn bed_at(p: &Plan) -> i32 {
+    // Turning left (bend > 0) the outer bank is the right one (side < 0).
+    let c = -p.bend.clamp(-1.0, 1.0) * BEND_SHIFT;
+    let e = ((p.side - c).abs() / (1.0 + c.abs())).clamp(0.0, 1.0);
+    let full = (p.water_y - p.bed_y) as f64;
+    p.water_y - (full * (1.0 - (1.0 - BED_EDGE) * e * e)).round().max(1.0) as i32
 }
 
