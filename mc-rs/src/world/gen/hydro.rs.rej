+/// Smooth value noise of the block (x, z), -4..4, on a 3-block lattice: `salt` makes the x and the z warp differ.
+fn warp(x: i32, z: i32, salt: i64) -> f64 {
+    let (fx, fz) = (x as f64 / 3.0, z as f64 / 3.0);
+    let (i, j) = (fx.floor(), fz.floor());
+    let (tx, tz) = (fx - i, fz - j);
+    let n = |a: f64, b: f64| unit4(0x1A4E, salt, a as i64, b as i64);
+    let top = n(i, j) * (1.0 - tx) + n(i + 1.0, j) * tx;
+    let bot = n(i, j + 1.0) * (1.0 - tx) + n(i + 1.0, j + 1.0) * tx;
+    ((top * (1.0 - tz) + bot * tz) - 0.5) * 8.0
+}
