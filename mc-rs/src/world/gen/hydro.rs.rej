+/// The mod's `StreamsSettings`, the parts that act when a column is carved or a current read (the ones that shape a network, `MIN_ACC`,
+/// `MIN_LEN`, are in its cache and stay constants).
+#[derive(Clone, Debug, PartialEq)]
+pub struct Settings {
+    /// Rivers and lakes on (`false`: the terrain's own water only; `current` is `None`).
+    pub enabled: bool,
+    /// `StreamsSettings.playerPush`, `boatPush`, `mobPush` (the mod's defaults 1.2, 2.0, 1.2): what a current's strength is multiplied by.
+    pub player_push: f64,
+    pub boat_push: f64,
+    pub mob_push: f64,
+    /// Water faster than this stays open in the cold.
+    pub ice_speed: f64,
+    /// `streamBiomeBlacklist`: no river is cut in these biomes (a lake still is).
+    pub blacklist: Vec<Biome>,
+}
+
+impl Default for Settings {
+    fn default() -> Self {
+        Self { enabled: true, player_push: 1.2, boat_push: 2.0, mob_push: 1.2, ice_speed: ICE_SPEED, blacklist: Vec::new() }
+    }
+}
+
+/// Who a current pushes (`CurrentPush.factor`: a player, a boat, anything else).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Push {
+    Player,
+    Boat,
+    Mob,
+}
+
+impl Settings {
+    fn factor(&self, k: Push) -> f64 {
+        match k {
+            Push::Player => self.player_push,
+            Push::Boat => self.boat_push,
+            Push::Mob => self.mob_push,
+        }
+    }
+
+    /// Reads `hydro:true|false`, `playerPush:1.2`, `boatPush:2.0`, `mobPush:1.2`, `hydroIceSpeed:1.2` and `hydroBlacklist:Desert,Beach` lines (the `options.txt` shape;
+    /// anything else is ignored, a bad value keeps the default). A biome is named as its variant, any case.
+    pub fn parse(text: &str, all: &[Biome]) -> Self {
+        let mut s = Self::default();
+        for line in text.lines() {
+            let Some((k, v)) = line.split_once(':') else { continue };
+            let v = v.trim();
+            match k.trim() {
+                "hydro" => s.enabled = v != "false",
+                "playerPush" => s.player_push = v.parse().unwrap_or(s.player_push).clamp(0.0, 10.0),
+                "boatPush" => s.boat_push = v.parse().unwrap_or(s.boat_push).clamp(0.0, 10.0),
+                "mobPush" => s.mob_push = v.parse().unwrap_or(s.mob_push).clamp(0.0, 10.0),
+                "hydroIceSpeed" => s.ice_speed = v.parse().unwrap_or(s.ice_speed),
+                "hydroBlacklist" => s.blacklist = v.split(',').filter_map(|n| all.iter().copied().find(|b| format!("{b:?}").eq_ignore_ascii_case(n.trim()))).collect(),
+                _ => {}
+            }
+        }
+        s
+    }
+}
+
+static SETTINGS: RwLock<Option<Settings>> = RwLock::new(None);
+
+/// The settings in force (the defaults until `configure`).
+pub fn settings() -> Settings {
+    SETTINGS.read().ok().and_then(|g| g.clone()).unwrap_or_default()
+}
+
+/// Sets the settings of the world being played. A river already carved stays as it is; a chunk made after this obeys.
+pub fn configure(s: Settings) {
+    if let Ok(mut g) = SETTINGS.write() {
+        *g = Some(s);
+    }
+}
+
+/// Where networks are kept between runs (`None`: nowhere). `FileNetworkStore`. A file holds one plate of one seed and world type; it does
+/// not know the Natural Temperature settings, so the caller sets no directory while those are on.
+static CACHE: Mutex<Option<PathBuf>> = Mutex::new(None);
+
+pub fn cache_dir(dir: Option<PathBuf>) {
+    if let Ok(mut c) = CACHE.lock() {
+        *c = dir;
+    }
+}
