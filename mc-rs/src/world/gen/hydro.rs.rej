+    fn the_cache_round_trips_and_refuses_a_cut_file() {
+        let net = made(&[(0.0, 0.0, 100.0, 0.0, 2.0), (100.0, 0.0, 200.0, 40.0, 2.0)]);
+        let b = net.to_bytes();
+        let back = Network::from_bytes(&b).expect("reads back");
+        assert_eq!(back.segs.len(), net.segs.len());
+        assert_eq!(back.plan(50.0, 1.0).map(|p| p.water_y), net.plan(50.0, 1.0).map(|p| p.water_y));
+        assert!(Network::from_bytes(&b[..b.len() - 1]).is_none());
+        assert!(Network::from_bytes(b"HYD\xff\0\0\0").is_none());
+    }
+
