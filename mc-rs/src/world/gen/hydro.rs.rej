+/// Little-endian reader for `Network::from_bytes`.
+struct Rd<'a>(&'a [u8]);
+
+impl Rd<'_> {
+    fn take<const N: usize>(&mut self) -> Option<[u8; N]> {
+        let (a, b) = self.0.split_at_checked(N)?;
+        self.0 = b;
+        a.try_into().ok()
+    }
+    fn u32(&mut self) -> Option<u32> {
+        self.take().map(u32::from_le_bytes)
+    }
+    fn i32(&mut self) -> Option<i32> {
+        self.take().map(i32::from_le_bytes)
+    }
+    fn f64(&mut self) -> Option<f64> {
+        self.take().map(f64::from_le_bytes)
+    }
+}
+
+impl Network {
+    /// `CACHE_VERSION`, the lattice, then the segments, the lake cells and the lake tops, all little endian. The index is made again on load.
+    fn to_bytes(&self) -> Vec<u8> {
+        let mut o = Vec::with_capacity(32 + self.segs.len() * 96 + self.lake_of.len() * 4);
+        o.extend(b"HYD");
+        o.extend(CACHE_VERSION.to_le_bytes());
+        for v in [self.g0.0, self.g0.1, self.n.0 as i32, self.n.1 as i32, self.segs.len() as i32, self.lake_top.len() as i32] {
+            o.extend(v.to_le_bytes());
+        }
+        for s in &self.segs {
+            for v in [s.x1, s.z1, s.y1, s.w1, s.x2, s.z2, s.y2, s.w2, s.sp, s.o1, s.o2, s.bend] {
+                o.extend(v.to_le_bytes());
+            }
+        }
+        for v in &self.lake_of {
+            o.extend(v.to_le_bytes());
+        }
+        for v in &self.lake_top {
+            o.extend(v.to_le_bytes());
+        }
+        o
+    }
+
+    /// `None` for a file of another version or one cut short (the plate is then routed again).
+    fn from_bytes(b: &[u8]) -> Option<Network> {
+        let mut r = Rd(b.strip_prefix(b"HYD")?);
+        if r.u32()? != CACHE_VERSION {
+            return None;
+        }
+        let (g0, n) = ((r.i32()?, r.i32()?), (r.i32()? as usize, r.i32()? as usize));
+        let (ns, nl) = (r.i32()? as usize, r.i32()? as usize);
+        if ns > 1 << 22 || nl > 1 << 20 || n.0 > 4096 || n.1 > 4096 {
+            return None;
+        }
+        let mut segs = Vec::with_capacity(ns);
+        for _ in 0..ns {
+            let mut f = [0.0; 12];
+            for v in &mut f {
+                *v = r.f64()?;
+            }
+            segs.push(Seg { x1: f[0], z1: f[1], y1: f[2], w1: f[3], x2: f[4], z2: f[5], y2: f[6], w2: f[7], sp: f[8], o1: f[9], o2: f[10], bend: f[11] });
+        }
+        let lake_of = (0..n.0 * n.1).map(|_| r.u32()).collect::<Option<Vec<_>>>()?;
+        let lake_top = (0..nl).map(|_| r.i32()).collect::<Option<Vec<_>>>()?;
+        let index = index_of(&segs);
+        Some(Network { segs, index, lake_of, lake_top, g0, n })
+    }
+}
+
 /// The grid cell (node index) a block belongs to: a node owns the 12 x 12 blocks round it.
 fn cell_of(v: f64) -> i32 {
     ((v + (CELL / 2) as f64) / CELL as f64).floor() as i32
