+
+    #[test]
+    fn the_bed_is_deepest_on_the_centre_line() {
+        assert_eq!(bed_at(&plan_at_side(0.0, 0.0)), 56);
+        assert!(bed_at(&plan_at_side(0.5, 0.0)) > 56 && bed_at(&plan_at_side(1.0, 0.0)) > bed_at(&plan_at_side(0.5, 0.0)));
+        assert_eq!(bed_at(&plan_at_side(1.0, 0.0)), 60); // 0.4 of 6 = 2.4 -> 2
+        assert_eq!(bed_at(&Plan { bed_y: 61, ..plan_at_side(1.0, 0.0) }), 61); // never under one block of water
+    }
+
+    #[test]
+    fn a_bend_digs_its_outer_bank() {
+        // Turning left, the outer bank is the right one (side < 0): deeper there than on the inner side, and the straight reach is even.
+        assert_eq!(bed_at(&plan_at_side(0.5, 0.0)), bed_at(&plan_at_side(-0.5, 0.0)));
+        assert!(bed_at(&plan_at_side(-0.5, 1.0)) < bed_at(&plan_at_side(0.5, 1.0)));
+        assert!(bed_at(&plan_at_side(0.5, -1.0)) < bed_at(&plan_at_side(-0.5, -1.0)));
+    }
+
