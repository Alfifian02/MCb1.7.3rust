+    /// What the World Preview paints at block (x, z): 1 where `carve` would cut a river's channel, 2 where it would fill a lake, 0 for dry
+    /// land. `ground` is the land's height there (`carve`'s `surface`) and `biome` the column's. The same rules as `carve`, read at one
+    /// column: off when `Settings::enabled` is off, a lake only over ground from 40 up to its top, the channel not in a blacklisted biome,
+    /// not under 5 blocks, not above 120, and not where the ground lies more than 6 blocks under the channel's bed (the river is not
+    /// cut into a pit).
+    pub fn water_at(&self, x: i32, z: i32, ground: i32, biome: Biome) -> u8 {
+        let set = settings();
+        if !set.enabled {
+            return 0;
+        }
+        let plan = self.plan_at(f64::from(x) + 0.5, f64::from(z) + 0.5);
+        if !plan.is_some_and(|p| p.in_channel) {
+            if let Some((top, _floor)) = self.nets.iter().find_map(|n| n.lake_top_at(x, z)) {
+                return if (40..top).contains(&ground) { 2 } else { 0 };
+            }
+        }
+        let Some(p) = plan.filter(|p| p.in_channel) else { return 0 };
+        if set.blacklist.contains(&biome) || ground < 5 || p.bed_y < 5 || p.water_y > 120 || ground + 6 < bed_at(&p) {
+            return 0;
+        }
+        1
+    }
