     /// A river's current points downstream (west here) at a speed in the mod's range.
+    fn plan_at_side(side: f64, bend: f64) -> Plan {
+        Plan { in_channel: true, water_y: 62, bed_y: 56, blend: 0.0, distance: side.abs() * 6.0, width: 6.0, grade: 62.0, dir: [1.0, 0.0], speed: 1.0, to_outlet: 0.0, side, bend }
