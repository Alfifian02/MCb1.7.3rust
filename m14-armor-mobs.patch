+        Cow => skin::COW,
+        Chicken => skin::CHICKEN,
+        Sheep => skin::SHEEP,
+        Wolf if m.tame => skin::WOLF_TAME,
+        Wolf if m.anger > 0 => skin::WOLF_ANGRY,
+        Wolf => skin::WOLF,
+        Squid => skin::SQUID,
+        Zombie | Giant => skin::ZOMBIE,
+        PigZombie => skin::PIGZOMBIE,
+        Skeleton => skin::SKELETON,
+        Creeper => skin::CREEPER,
+        Spider => skin::SPIDER,
+        Slime => skin::SLIME,
+    }
+}
