+/// A vertex tint (`mesh::WHITE`'s packing) from linear 0..1 channels.
+fn tint(r: f32, g: f32, b: f32) -> f32 {
+    let q = |c: f32| (c.clamp(0.0, 1.0) * 255.0).round() as u32;
+    ((q(r) << 16) | (q(g) << 8) | q(b)) as f32
