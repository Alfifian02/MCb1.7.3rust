+        let mut q: [(Vec3, (f32, f32)); 4] = [(Vec3::ZERO, (0.0, 0.0)); 4];
+        let uv = [(u1 - 0.1, v0 + 0.1), (u0 + 0.1, v0 + 0.1), (u0 + 0.1, v1 - 0.1), (u1 - 0.1, v1 - 0.1)];
