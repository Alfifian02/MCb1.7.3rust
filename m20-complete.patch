+/// The spring both gauges use: the shown angle `s.0` chases `target` (the difference wrapped to +-pi, then to +-1), `s.1` is its
+/// speed (`+= diff * 0.1`, `*= 0.8`).
+fn chase(s: &mut (f64, f64), target: f64) {
+    use std::f64::consts::{PI, TAU};
+    let mut d = target - s.0;
+    while d < -PI { d += TAU }
+    while d >= PI { d -= TAU }
+    d = d.clamp(-1.0, 1.0);
+    s.1 = (s.1 + d * 0.1) * 0.8;
+    s.0 += s.1;
