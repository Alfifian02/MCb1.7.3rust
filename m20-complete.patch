+        if (0..16).contains(&x) && (0..16).contains(&y) { t[(y * 16 + x) as usize * 4..][..4].copy_from_slice(&rgba) }
+    };
+    for i in -4..=4 {
+        put(8.5 + c * i as f64 * 0.3, 7.5 - s * i as f64 * 0.3 * 0.5, [100, 100, 100, 255]);
+    }
