+fn items_tile(t: u8) -> Tile {
+    let mut o = [0u8; 1024];
+    for r in 0..16 {
+        let src = ((t as usize / 16 * 16 + r) * 256 + t as usize % 16 * 16) * 4;
+        o[r * 64..][..64].copy_from_slice(&crate::render::atlas::ITEMS[src..src + 64]);
