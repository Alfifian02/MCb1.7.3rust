<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_pill_background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/medium_margin">

        <!-- Video only -->
        <LinearLayout
            android:id="@+id/section_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/ProPanelLabel"
                android:text="@string/frame_rate" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/frame_rate_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/stabilization_switch"
                style="@style/ProPanelSwitch"
                android:text="@string/video_stabilization" />
        </LinearLayout>

        <!-- Photo only -->
        <LinearLayout
            android:id="@+id/section_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/ProPanelLabel"
                android:text="@string/drive_mode" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/drive_mode_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/burst_size_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/smaller_margin"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/burst_size_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/interval_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/smaller_margin"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/interval_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/raw_switch"
                style="@style/ProPanelSwitch"
                android:text="@string/raw_format"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Photo and video -->
        <LinearLayout
            android:id="@+id/section_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/manual_exposure_switch"
                style="@style/ProPanelSwitch"
                android:text="@string/manual_exposure" />

            <LinearLayout
                android:id="@+id/manual_exposure_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ProPanelLabel"
                        android:layout_width="64dp"
                        android:text="@string/iso" />

                    <SeekBar
                        android:id="@+id/iso_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/iso" />

                    <TextView
                        android:id="@+id/iso_value"
                        style="@style/ProPanelValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ProPanelLabel"
                        android:layout_width="64dp"
                        android:text="@string/shutter_speed" />

                    <SeekBar
                        android:id="@+id/shutter_seekbar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/shutter_speed" />

                    <TextView
                        android:id="@+id/shutter_value"
                        style="@style/ProPanelValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/white_balance_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/ProPanelLabel"
                    android:text="@string/white_balance" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/white_balance_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/histogram_switch"
            style="@style/ProPanelSwitch"
            android:text="@string/histogram" />

    </LinearLayout>
</ScrollView>
