+// Color grading applied before tone mapping; rgb := color in rec. 2020 [0, inf]
+fn grade_input(rgb_in: vec3<f32>) -> vec3<f32> {
+    var rgb = rgb_in;
+    let brightness = 0.83 * GRADE_BRIGHTNESS;
+    let contrast = 1.00 * GRADE_CONTRAST;
+    let saturation = 0.98 * GRADE_SATURATION;
