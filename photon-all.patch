+    let b = fetch(tex_a, texel + vec2<i32>(0, 1)).rgb;
+    let c = fetch(tex_a, texel + vec2<i32>(1, 1)).rgb;
+    let d = fetch(tex_a, texel + vec2<i32>(-1, 0)).rgb;
+    let e = fetch(tex_a, texel).rgb;
+    let f = fetch(tex_a, texel + vec2<i32>(1, 0)).rgb;
+    let g = fetch(tex_a, texel + vec2<i32>(-1, -1)).rgb;
+    let h = fetch(tex_a, texel + vec2<i32>(0, -1)).rgb;
+    let i = fetch(tex_a, texel + vec2<i32>(1, -1)).rgb;
