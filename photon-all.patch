+    var v = vignette_size * (uv.x * uv.y - uv.x) * (uv.x * uv.y - uv.y);
+    v = pow(v, vignette_intensity + 0.1 * u.misc2.x + 0.3 * u.misc.z + 0.2 * darkness_pulse * u.misc.w);
+    return v;
+}
