+    let luma = fxaa_luma(e);
+    let luma_u = fxaa_luma(b);
+    let luma_l = fxaa_luma(d);
+    let luma_r = fxaa_luma(f);
+    let luma_d = fxaa_luma(h);
+
+    // Maximum and minimum luma around the current fragment
+    let luma_min = min_of5f(luma, luma_d, luma_u, luma_l, luma_r);
+    let luma_max = max_of5f(luma, luma_d, luma_u, luma_l, luma_r);
