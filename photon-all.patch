+// ===========================================================================================================================
+//  ACES (include/post_processing/aces) + tonemap_operators.glsl
+// ===========================================================================================================================
+
+const RRT_GLOW_GAIN: f32 = 0.1;   // default: 0.05
+const RRT_GLOW_MID: f32 = 0.08;   // default: 0.08
+const RRT_RED_SCALE: f32 = 1.0;   // default: 0.82
+const RRT_RED_PIVOT: f32 = 0.03;  // default: 0.03
+const RRT_RED_HUE: f32 = 0.0;     // default: 0.0
+const RRT_RED_WIDTH: f32 = 135.0; // default: 135.0
+const RRT_SAT_FACTOR: f32 = 0.96; // default: 0.96
+const ODT_SAT_FACTOR: f32 = 1.0;  // default: 0.93
+const RRT_GAMMA_CURVE: f32 = 0.96;
+const CINEMA_WHITE: f32 = 48.0;
+const CINEMA_BLACK: f32 = 0.02;
+
+fn log10(x: f32) -> f32 { return log(x) * (1.0 / log(10.0)); }
+
+fn xyz_to_xy_y(xyz: vec3<f32>) -> vec3<f32> {
+    let m = 1.0 / max(xyz.x + xyz.y + xyz.z, 1e-10);
+    return vec3<f32>(xyz.x * m, xyz.y * m, xyz.y);
+}
+
+fn xy_y_to_xyz(xy_y: vec3<f32>) -> vec3<f32> {
+    let m = xy_y.z / max(xy_y.y, 1e-10);
+    return vec3<f32>(xy_y.x * m, xy_y.z, (1.0 - xy_y.x - xy_y.y) * m);
+}
+
+fn rgb_to_saturation(rgb: vec3<f32>) -> f32 {
+    let max_component = max(max_of3(rgb), 1e-10);
+    let min_component = max(min_of3(rgb), 1e-10);
+    return (max_component - min_component) / max_component;
+}
+
+// Geometric hue angle in degrees (0-360); 0 for neutral colors
+fn rgb_to_hue(rgb: vec3<f32>) -> f32 {
+    if (rgb.r == rgb.g && rgb.g == rgb.b) { return 0.0; }
+    var hue = (360.0 / TAU) * atan2(2.0 * rgb.r - rgb.g - rgb.b, sqrt(3.0) * (rgb.g - rgb.b));
+    if (hue < 0.0) { hue = hue + 360.0; }
+    return hue;
+}
+
+// Converts RGB to a luminance proxy, here called YC (~ Y + K * Chroma)
+fn rgb_to_yc(rgb: vec3<f32>) -> f32 {
+    let yc_radius_weight = 1.75;
+    let chroma = sqrt(rgb.b * (rgb.b - rgb.g) + rgb.g * (rgb.g - rgb.r) + rgb.r * (rgb.r - rgb.b));
+    return (1.0 / 3.0) * (rgb.r + rgb.g + rgb.b + yc_radius_weight * chroma);
+}
+
+fn glow_fwd(yc_in: f32, glow_gain_in: f32, glow_mid: f32) -> f32 {
+    var glow_gain_out: f32;
+    if (yc_in <= 2.0 / 3.0 * glow_mid) {
+        glow_gain_out = glow_gain_in;
+    } else if (yc_in >= 2.0 * glow_mid) {
+        glow_gain_out = 0.0;
+    } else {
+        glow_gain_out = glow_gain_in * (glow_mid / yc_in - 0.5);
+    }
+    return glow_gain_out;
+}
+
+// Sigmoid function in the range 0 to 1 spanning -2 to +2
+fn sigmoid_shaper(x: f32) -> f32 {
+    let t = max0(1.0 - abs(0.5 * x));
+    let y = 1.0 + sign(x) * (1.0 - t * t);
+    return 0.5 * y;
+}
+
+fn cubic_basis_shaper_fit(x: f32, width: f32) -> f32 {
+    let radius = 0.5 * width;
+    if (abs(x) < radius) { return sqr(cubic_smooth(1.0 - abs(x) / radius)); }
+    return 0.0;
+}
+
+fn center_hue(hue: f32, center_h: f32) -> f32 {
+    let hue_centered = hue - center_h;
+    if (hue_centered < -180.0) { return hue_centered + 360.0; }
+    if (hue_centered > 180.0) { return hue_centered - 360.0; }
+    return hue_centered;
+}
+
+fn rrt_sweeteners(aces_in: vec3<f32>) -> vec3<f32> {
+    var aces = aces_in;
+    // Glow module
+    let saturation = rgb_to_saturation(aces);
+    let yc_in = rgb_to_yc(aces);
+    let s = sigmoid_shaper(5.0 * saturation - 2.0);
+    let added_glow = 1.0 + glow_fwd(yc_in, RRT_GLOW_GAIN * s, RRT_GLOW_MID);
+    aces = aces * added_glow;
+
+    // Red modifier
+    let hue = rgb_to_hue(aces);
+    let centered_hue = center_hue(hue, RRT_RED_HUE);
+    let hue_weight = cubic_basis_shaper_fit(centered_hue, RRT_RED_WIDTH);
+    aces.r = aces.r + hue_weight * saturation * (RRT_RED_PIVOT - aces.r) * (1.0 - RRT_RED_SCALE);
+
+    // ACES to RGB rendering space
+    var rgb_pre = max0v(aces) * ap0_to_ap1;
+
+    // Global desaturation
+    let luminance = dot(rgb_pre, LUMINANCE_WEIGHTS_AP1);
+    rgb_pre = mix(vec3<f32>(luminance), rgb_pre, RRT_SAT_FACTOR);
+
+    // Added gamma adjustment before the RRT
+    rgb_pre = pow(rgb_pre, vec3<f32>(RRT_GAMMA_CURVE));
+    return rgb_pre;
+}
+
+// Textbook monomial to basis-function conversion matrix
+const SPLINE_M: mat3x3<f32> = mat3x3<f32>(0.5, -1.0, 0.5, -1.0, 1.0, 0.5, 0.5, 0.0, 0.0);
+
+var<private> C5_COEFF_LOW: array<f32, 6> = array<f32, 6>(-4.0, -4.0, -3.1573765773, -0.4852499958, 1.8477324706, 1.8477324706);
+var<private> C5_COEFF_HIGH: array<f32, 6> = array<f32, 6>(-0.7185482425, 2.0810307172, 3.6681241237, 4.0, 4.0, 4.0);
+
+fn segmented_spline_c5_fwd(x: f32) -> f32 {
+    // RRT parameters: slope_low = slope_high = 0
+    let slope_low = 0.0;
+    let slope_high = 0.0;
+    let log_x = log10(max(x, EPS));
+    var log_y: f32;
+    if (log_x <= C5_MIN_X) {
+        log_y = log_x * slope_low + (C5_MIN_Y - slope_low * C5_MIN_X);
+    } else if (log_x > C5_MIN_X && log_x < C5_MID_X) {
+        let knot_coord = 3.0 * (log_x - C5_MIN_X) / (C5_MID_X - C5_MIN_X);
+        let i = u32(knot_coord);
+        let f = fract(knot_coord);
+        let cf = vec3<f32>(C5_COEFF_LOW[i], C5_COEFF_LOW[i + 1u], C5_COEFF_LOW[i + 2u]);
+        let monomials = vec3<f32>(f * f, f, 1.0);
+        log_y = dot(monomials, SPLINE_M * cf);
+    } else if (log_x >= C5_MID_X && log_x <= C5_MAX_X) {
