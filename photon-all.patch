+    // Saturation
+    let lum = dot(rgb, LUMINANCE_WEIGHTS_REC2020);
+    rgb = max0v(mix(vec3<f32>(lum), rgb, saturation));
+
+    // White balance
+    if (GRADE_WB_ON) {
+        let white_balance_matrix = mat3x3<f32>(u.wb0.xyz, u.wb1.xyz, u.wb2.xyz);
+        rgb = rgb * rec2020_to_xyz;
+        rgb = rgb * white_balance_matrix;
+        rgb = rgb * xyz_to_rec2020;
+    }
+
+    return max0v(rgb);
+}
+
+// Color grading applied after tone mapping; rgb := color in linear rec. 709 [0, 1]
+fn grade_output(rgb_in: vec3<f32>) -> vec3<f32> {
+    // Convert to roughly perceptual RGB for color grading
+    var rgb = sqrt(rgb_in);
