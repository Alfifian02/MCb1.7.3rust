+// ===========================================================================================================================
+//  c5_c10_bloom_downsample (tile index in p.i.x; tile 0 reads the history, the others the previous tile)
+// ===========================================================================================================================
+
+@fragment
+fn fs_bloom_down(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let uv = pass_uv(pos);
+    let vps = u.res.zw;
+    let tile = p.i.x;
+
+    var src_tile_scale = 1.0;
+    var src_tile_offset = vec2<f32>(0.0);
+    if (tile > 0) {
+        src_tile_scale = bloom_tile_scale(tile - 1);
+        src_tile_offset = bloom_tile_offset(tile - 1);
+    }
+
+    let pad_amount = 3.0 * vps / src_tile_scale;
+    let uv_src = clamp(uv, pad_amount, vec2<f32>(1.0) - pad_amount) * src_tile_scale + src_tile_offset;
+
+    // 6x6 downsampling filter made from overlapping 4x4 box kernels, as described in "Next Generation Post-Processing in
+    // Call of Duty Advanced Warfare"
+    var bloom_tile = smp(tex_a, uv_src + vec2<f32>(0.0, 0.0) * vps).rgb * 0.125;
+
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(1.0, 1.0) * vps).rgb * 0.125;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(-1.0, 1.0) * vps).rgb * 0.125;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(1.0, -1.0) * vps).rgb * 0.125;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(-1.0, -1.0) * vps).rgb * 0.125;
+
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(2.0, 0.0) * vps).rgb * 0.0625;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(-2.0, 0.0) * vps).rgb * 0.0625;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(0.0, 2.0) * vps).rgb * 0.0625;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(0.0, -2.0) * vps).rgb * 0.0625;
+
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(2.0, 2.0) * vps).rgb * 0.03125;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(-2.0, 2.0) * vps).rgb * 0.03125;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(2.0, -2.0) * vps).rgb * 0.03125;
+    bloom_tile = bloom_tile + smp(tex_a, uv_src + vec2<f32>(-2.0, -2.0) * vps).rgb * 0.03125;
+
+    return vec4<f32>(bloom_tile, 1.0);
+}
+
+// ===========================================================================================================================
+//  c11_bloom_merge_buffers: copy the odd tiles from the read buffer to the write buffer
+// ===========================================================================================================================
+
+@fragment
+fn fs_bloom_merge(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let uv = pass_uv(pos);
+    let tile_index = i32(-log2(1.0 - uv.x));
+
+    if ((tile_index & 1) == 1) {
+        return vec4<f32>(fetch(tex_a, vec2<i32>(pos.xy)).rgb, 1.0);
+    }
+    discard;
+}
+
+// ===========================================================================================================================
+//  c12 / c13 bloom gaussian (9-tap binomial)
+// ===========================================================================================================================
+
+fn binomial_weight_9(i: i32) -> f32 {
+    var w = array<f32, 5>(0.2734375, 0.21875, 0.109375, 0.03125, 0.00390625);
+    return w[abs(i)];
+}
+
+@fragment
+fn fs_bloom_gauss_h(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let texel = vec2<i32>(pos.xy);
+    let uv = pass_uv(pos);
+
+    // Calculate the bounds of the tile containing the fragment
+    let tile_index = i32(-log2(1.0 - uv.x));
+
+    let tile_scale = bloom_tile_scale(tile_index);
+    let tile_offset = bloom_tile_offset(tile_index);
+
+    let bounds_min = vec2<i32>(u.res.xy * tile_offset);
+    let bounds_max = vec2<i32>(u.res.xy * (tile_offset + tile_scale));
+
+    // Discard fragments that aren't part of a bloom tile
+    if (clamp(texel.y, bounds_min.y, bounds_max.y) != texel.y || tile_index > 5) {
+        discard;
+    }
+
+    // Horizontal 9-tap gaussian blur
+    var bloom_tiles = vec3<f32>(0.0);
+    var weight_sum = 0.0;
+    for (var i = -4; i <= 4; i = i + 1) {
+        let q = texel + vec2<i32>(i, 0);
+        let weight = binomial_weight_9(i) * select(0.0, 1.0, clamp(q.x, bounds_min.x + 2, bounds_max.x - 2) == q.x);
+        bloom_tiles = bloom_tiles + fetch(tex_a, q).rgb * weight;
+        weight_sum = weight_sum + weight;
+    }
+    return vec4<f32>(bloom_tiles / weight_sum, 1.0);
+}
+
+@fragment
+fn fs_bloom_gauss_v(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let texel = vec2<i32>(pos.xy);
+    let uv = pass_uv(pos);
+
+    // Calculate the bounds of the tile containing the fragment
+    let a = -log2(1.0 - uv.x);
+    let tile_index = i32(a);
+
+    let tile_scale = bloom_tile_scale(tile_index);
+    let tile_offset = bloom_tile_offset(tile_index);
+
+    let bounds_min = vec2<i32>(u.res.xy * tile_offset);
+    let bounds_max = vec2<i32>(u.res.xy * (tile_offset + tile_scale));
+
+    // Apply padding around bloom tiles
+    if (clamp(texel.y, bounds_min.y, bounds_max.y) != texel.y || tile_index > 5) {
+        // Get index of closest tile
+        var closest_tile = i32(0.5 * a - 0.25) * 2 + 1;
+        if (uv.y < 0.66) { closest_tile = i32(0.5 * a + 0.25) * 2; }
+
+        // Get bounds of closest tile
+        let closest_scale = bloom_tile_scale(closest_tile);
+        let closest_offset = bloom_tile_offset(closest_tile);
+        let closest_bounds_min = vec2<i32>(u.res.xy * closest_offset + 1.0);
+        let closest_bounds_max = vec2<i32>(u.res.xy * (closest_offset + closest_scale) - 1.0);
+
+        // Clamp to closest tile
+        return vec4<f32>(fetch(tex_a, clamp(texel, closest_bounds_min, closest_bounds_max)).rgb, 1.0);
+    }
+
+    // Vertical 9-tap gaussian blur
+    var bloom_tiles = vec3<f32>(0.0);
+    var weight_sum = 0.0;
+    for (var i = -4; i <= 4; i = i + 1) {
+        let q = texel + vec2<i32>(0, i);
+        let weight = binomial_weight_9(i) * select(0.0, 1.0, clamp(q.y, bounds_min.y + 2, bounds_max.y - 2) == q.y);
+        bloom_tiles = bloom_tiles + fetch(tex_a, q).rgb * weight;
+        weight_sum = weight_sum + weight;
+    }
+    return vec4<f32>(bloom_tiles / weight_sum, 1.0);
+}
+
+// ===========================================================================================================================
+//  c14_c18_bloom_upsample (tile index in p.i.x: 4, 3, 2, 1, 0)
+// ===========================================================================================================================
+
+fn bloom_upsampling_filter(uv: vec2<f32>) -> vec4<f32> {
+    if (BLOOM_BICUBIC) { return bicubic_filter(tex_a, uv); }
+    return smp(tex_a, uv);
+}
+
+@fragment
+fn fs_bloom_up(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let texel = vec2<i32>(pos.xy);
+    let uv = pass_uv(pos);
+    let tile = p.i.x;
+    let tile_scale = bloom_tile_scale(tile);
+    let src_tile_scale = bloom_tile_scale(tile + 1);
+    let src_tile_offset = bloom_tile_offset(tile + 1);
+
+    let pad_amount = 3.0 * u.res.zw / tile_scale;
+    let uv_src = clamp(uv, pad_amount, vec2<f32>(1.0) - pad_amount) * src_tile_scale + src_tile_offset;
+
+    let src_weight = mix(0.25, 0.90, 0.5 * BLOOM_SPREAD);
+    var bloom_tile = fetch(tex_a, texel).rgb * (1.0 - src_weight); // Destination tile.
+    bloom_tile = bloom_tile + bloom_upsampling_filter(uv_src).rgb * src_weight; // Source tile.
+    return vec4<f32>(bloom_tile, 1.0);
+}
