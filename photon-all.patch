+    let luma_vertical = luma_l + luma_r;
+
+    let luma_left_corners = luma_dl + luma_ul;
+    let luma_down_corners = luma_dl + luma_dr;
+    let luma_right_corners = luma_dr + luma_ur;
+    let luma_up_corners = luma_ul + luma_ur;
