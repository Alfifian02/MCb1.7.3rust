+    let log_max = vec2<f32>(3.0024764538, 1.6812412739);
+    let log_x = log10(max(x, EPS));
+    var log_y: f32;
+    if (log_x <= log_min.x) {
+        log_y = log_x * slope_low + (log_min.y - slope_low * log_min.x);
+    } else if (log_x > log_min.x && log_x < log_mid.x) {
+        let knot_coord = 7.0 * (log_x - log_min.x) / (log_mid.x - log_min.x);
+        let i = u32(knot_coord);
+        let f = fract(knot_coord);
+        let cf = vec3<f32>(C9_COEFF_LOW[i], C9_COEFF_LOW[i + 1u], C9_COEFF_LOW[i + 2u]);
+        let monomials = vec3<f32>(f * f, f, 1.0);
+        log_y = dot(monomials, SPLINE_M * cf);
+    } else if (log_x >= log_mid.x && log_x <= log_max.x) {
+        let knot_coord = 7.0 * (log_x - log_mid.x) / (log_max.x - log_mid.x);
+        let i = u32(knot_coord);
+        let f = fract(knot_coord);
+        let cf = vec3<f32>(C9_COEFF_HIGH[i], C9_COEFF_HIGH[i + 1u], C9_COEFF_HIGH[i + 2u]);
+        let monomials = vec3<f32>(f * f, f, 1.0);
+        log_y = dot(monomials, SPLINE_M * cf);
+    } else {
+        log_y = log_x * slope_high + (log_max.y - slope_high * log_max.x);
+    }
+    return pow(10.0, log_y);
