+    // Greens
+    let green = isolate_hue(hsl, 90.0, 44.0);
+    hsl.x = hsl.x + GRADE_GREEN_HUE_SHIFT * green;
+    hsl.y = hsl.y * (1.0 + GRADE_GREEN_SAT_BOOST * green);
