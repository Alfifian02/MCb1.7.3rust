+    var luma_end_1 = fxaa_luma(smp(tex_a, uv1).rgb);
+    var luma_end_2 = fxaa_luma(smp(tex_a, uv2).rgb);
+    luma_end_1 = luma_end_1 - luma_local_average;
+    luma_end_2 = luma_end_2 - luma_local_average;
