@@ -0,0 +1,1392 @@
+// Photon Shader by SixthSurge, post chain (program/c2, c4, c5..c19, c21, final) ported to WGSL for mc-rs.
+// The text before this file (consts, matrices) is generated by `render/post.rs::prelude`; read its header for the GLSL -> WGSL
+// conventions (y-down uv, depth 0..1, explicit bloom ping-pong, clamped texelFetch).
+
+struct U {
+    proj: mat4x4<f32>,       // gbufferProjection (unjittered)
+    proj_inv: mat4x4<f32>,
+    mv_inv: mat4x4<f32>,     // gbufferModelViewInverse (rotation only: scene space = world - camera)
+    prev_mv: mat4x4<f32>,
+    prev_proj: mat4x4<f32>,
+    cam: vec4<f32>,          // cameraPosition, frameTime
+    prev_cam: vec4<f32>,     // previousCameraPosition, frameTimeCounter
+    res: vec4<f32>,          // view_res, view_pixel_size
+    misc: vec4<f32>,         // aspectRatio, frameCounter, blindness, darknessFactor
+    misc2: vec4<f32>,        // biome_cave
+    wb0: vec4<f32>,          // white_balance_matrix columns
+    wb1: vec4<f32>,
+    wb2: vec4<f32>,
+};
+
+struct P {
+    rect: vec4<f32>,         // viewport of the pass in pixels (bloom tile or whole target)
+    i: vec4<i32>,            // x: bloom tile index
+};
+
+@group(0) @binding(0) var<uniform> u: U;
+@group(0) @binding(1) var samp: sampler;
+@group(0) @binding(2) var tex_a: texture_2d<f32>;      // colortex0 (what the pass reads)
+@group(0) @binding(3) var tex_b: texture_2d<f32>;      // colortex5 (history)
+@group(0) @binding(4) var tex_c: texture_2d<f32>;      // exposure (r) and centerDepthSmooth (g)
+@group(0) @binding(5) var tex_depth: texture_depth_2d; // depthtex0
+@group(0) @binding(6) var tex_noise: texture_2d<f32>;  // noisetex (blue channel in r)
+@group(1) @binding(0) var<uniform> p: P;
+
+const PI: f32 = 3.14159265358979323846;
+const TAU: f32 = 6.28318530717958647692;
+const EPS: f32 = 1e-6;
+const HAND_DEPTH: f32 = 0.56; // ponytail: mc-rs has no hand, so only something within ~0.11 block of the eye is below it
+
+// ---- global.glsl helpers ----------------------------------------------------------------------------------------------
+
+fn sqr(x: f32) -> f32 { return x * x; }
+fn sqr3(v: vec3<f32>) -> vec3<f32> { return v * v; }
+fn cube(x: f32) -> f32 { return x * x * x; }
+fn c01(x: f32) -> f32 { return clamp(x, 0.0, 1.0); }
+fn c01v(v: vec3<f32>) -> vec3<f32> { return clamp(v, vec3<f32>(0.0), vec3<f32>(1.0)); }
+fn c01v2(v: vec2<f32>) -> vec2<f32> { return clamp(v, vec2<f32>(0.0), vec2<f32>(1.0)); }
+fn max0(x: f32) -> f32 { return max(x, 0.0); }
+fn max0v(v: vec3<f32>) -> vec3<f32> { return max(v, vec3<f32>(0.0)); }
+fn max_of3(v: vec3<f32>) -> f32 { return max(v.x, max(v.y, v.z)); }
+fn min_of3(v: vec3<f32>) -> f32 { return min(v.x, min(v.y, v.z)); }
+fn max_of2(v: vec2<f32>) -> f32 { return max(v.x, v.y); }
+fn max_of4(v: vec4<f32>) -> f32 { return max(v.x, max(v.y, max(v.z, v.w))); }
+fn linear_step(e0: f32, e1: f32, x: f32) -> f32 { return c01((x - e0) / (e1 - e0)); }
+fn dampen(x: f32) -> f32 { let y = c01(x); return y * (2.0 - y); }
+fn cubic_smooth(x: f32) -> f32 { return sqr(x) * (3.0 - 2.0 * x); }
+fn cubic_smooth2(x: vec2<f32>) -> vec2<f32> { return x * x * (vec2<f32>(3.0) - 2.0 * x); }
+
+fn pulse(x: f32, center: f32, width: f32) -> f32 {
+    let y = abs(x - center) / width;
+    if (y > 1.0) { return 0.0; }
+    return 1.0 - cubic_smooth(y);
+}
+
+fn pulse_period(x: f32, center: f32, width: f32, period: f32) -> f32 {
+    var y = (x - center + 0.5 * period) / period;
+    y = fract(y) * period - (0.5 * period);
+    return pulse(y, 0.0, width);
+}
+
+fn bloom_tile_scale(i: i32) -> f32 { return 0.5 * exp2(-f32(i)); }
+fn bloom_tile_offset(i: i32) -> vec2<f32> {
+    return vec2<f32>(1.0 - exp2(-f32(i)), f32(i & 1) * (1.0 - 0.5 * exp2(-f32(i))));
+}
+
+// ---- fetch / sample helpers -------------------------------------------------------------------------------------------
+
+fn smp(t: texture_2d<f32>, uv: vec2<f32>) -> vec4<f32> {
+    return textureSampleLevel(t, samp, uv, 0.0);
+}
+
+fn fetch(t: texture_2d<f32>, texel: vec2<i32>) -> vec4<f32> {
+    let d = vec2<i32>(textureDimensions(t, 0));
+    return textureLoad(t, clamp(texel, vec2<i32>(0), d - vec2<i32>(1)), 0);
+}
+
+fn fetch_depth(texel: vec2<i32>) -> f32 {
+    let d = vec2<i32>(textureDimensions(tex_depth));
+    return textureLoad(tex_depth, clamp(texel, vec2<i32>(0), d - vec2<i32>(1)), 0);
+}
+
+fn pass_uv(pos: vec4<f32>) -> vec2<f32> {
+    return (pos.xy - p.rect.xy) / p.rect.zw;
+}
+
+@vertex
+fn vs_full(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {
+    let q = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    return vec4<f32>(q * 2.0 - 1.0, 0.0, 1.0);
+}
+
+// ---- utility/color.glsl -----------------------------------------------------------------------------------------------
+
+const LUMINANCE_WEIGHTS_REC2020: vec3<f32> = vec3<f32>(0.2627, 0.6780, 0.0593); // luminance_weights
+const LUMINANCE_WEIGHTS_AP1: vec3<f32> = vec3<f32>(0.2722, 0.6741, 0.0537);
+
+fn srgb_eotf(l: vec3<f32>) -> vec3<f32> {
+    return 1.14374 * (-0.126893 * l + sqrt(l)); // from Jodie in #snippets
+}
+
+fn srgb_eotf_inv(s: vec3<f32>) -> vec3<f32> {
+    return s * (s * (s * 0.305306011 + 0.682171111) + 0.012522878);
+}
+
+fn rgb_to_hsl(c: vec3<f32>) -> vec3<f32> {
+    let k = vec4<f32>(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
+    let pp = mix(vec4<f32>(c.bg, k.wz), vec4<f32>(c.gb, k.xy), step(c.b, c.g));
+    let q = mix(vec4<f32>(pp.xyw, c.r), vec4<f32>(c.r, pp.yzx), step(pp.x, c.r));
+    let d = q.x - min(q.w, q.y);
+    let e = 1e-6;
+    return vec3<f32>(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
+}
+
+fn hsl_to_rgb(c: vec3<f32>) -> vec3<f32> {
+    let k = vec4<f32>(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
+    let s = c01(c.y);
+    let l = c01(c.z);
+    let pp = abs(fract(vec3<f32>(c.x) + k.xyz) * 6.0 - k.www);
+    return l * mix(k.xxx, c01v(pp - k.xxx), s);
+}
+
+fn rgb_to_ycocg(rgb: vec3<f32>) -> vec3<f32> {
+    let cm = mat3x3<f32>(0.25, 0.5, 0.25, 0.5, 0.0, -0.5, -0.25, 0.5, -0.25);
+    return rgb * cm;
+}
+
+fn ycocg_to_rgb(ycocg: vec3<f32>) -> vec3<f32> {
+    let tmp = ycocg.x - ycocg.z;
+    return vec3<f32>(tmp + ycocg.y, ycocg.x + ycocg.z, tmp - ycocg.y);
+}
+
+fn isolate_hue(hsl: vec3<f32>, center: f32, width: f32) -> f32 {
+    if (hsl.y < 1e-2 || hsl.z < 1e-2) { return 0.0; } // black/gray colors with no hue
+    return pulse_period(hsl.x * 360.0, center, width, 360.0);
+}
+
+// ---- utility/bicubic.glsl ---------------------------------------------------------------------------------------------
+
+fn bicubic_weights(v: f32) -> vec4<f32> {
+    let n = vec4<f32>(1.0, 2.0, 3.0, 4.0) - v;
+    let s = n * n * n;
+    let x = s.x;
+    let y = s.y - 4.0 * s.x;
+    let z = s.z - 4.0 * s.y + 6.0 * s.x;
+    let w = 6.0 - x - y - z;
+    return vec4<f32>(x, y, z, w) * (1.0 / 6.0);
+}
+
+// bicubic_filter_lod(sampler, coord, 0)
+fn bicubic_filter(t: texture_2d<f32>, coord_in: vec2<f32>) -> vec4<f32> {
+    let res = vec2<f32>(textureDimensions(t, 0));
+    let vps = 1.0 / res;
+    var coord = coord_in * res - 0.5;
+    let fxy = fract(coord);
+    coord = coord - fxy;
+    let xw = bicubic_weights(fxy.x);
+    let yw = bicubic_weights(fxy.y);
+    let c = coord.xxyy + vec2<f32>(-0.5, 1.5).xyxy;
+    let s = vec4<f32>(xw.xz + xw.yw, yw.xz + yw.yw);
+    var offset = c + vec4<f32>(xw.yw, yw.yw) / s;
+    offset = offset * vps.xxyy;
+    let sample0 = smp(t, offset.xz);
+    let sample1 = smp(t, offset.yz);
+    let sample2 = smp(t, offset.xw);
+    let sample3 = smp(t, offset.yw);
+    let sx = s.x / (s.x + s.y);
+    let sy = s.z / (s.z + s.w);
+    return mix(mix(sample3, sample2, sx), mix(sample1, sample0, sx), sy);
+}
+
+// catmull_rom_filter_fast_rgb: approximation from the Siggraph 2016 SMAA presentation
+fn catmull_rom_fast_rgb(t: texture_2d<f32>, coord: vec2<f32>, sharpness: f32) -> vec3<f32> {
+    let res = vec2<f32>(textureDimensions(t, 0));
+    let vps = 1.0 / res;
+    let position = res * coord;
+    let center_position = floor(position - 0.5) + 0.5;
+    let f = position - center_position;
+    let f2 = f * f;
+    let f3 = f * f2;
+    let w0 = -sharpness * f3 + 2.0 * sharpness * f2 - sharpness * f;
+    let w1 = (2.0 - sharpness) * f3 - (3.0 - sharpness) * f2 + 1.0;
+    let w2 = -(2.0 - sharpness) * f3 + (3.0 - 2.0 * sharpness) * f2 + sharpness * f;
+    let w3 = sharpness * f3 - sharpness * f2;
+    let w12 = w1 + w2;
+    let tc12 = vps * (center_position + w2 / w12);
+    let center_color = smp(t, vec2<f32>(tc12.x, tc12.y)).rgb;
+    let tc0 = vps * (center_position - 1.0);
+    let tc3 = vps * (center_position + 2.0);
+    let color = vec4<f32>(smp(t, vec2<f32>(tc12.x, tc0.y)).rgb, 1.0) * (w12.x * w0.y)
+        + vec4<f32>(smp(t, vec2<f32>(tc0.x, tc12.y)).rgb, 1.0) * (w0.x * w12.y)
+        + vec4<f32>(center_color, 1.0) * (w12.x * w12.y)
+        + vec4<f32>(smp(t, vec2<f32>(tc3.x, tc12.y)).rgb, 1.0) * (w3.x * w12.y)
+        + vec4<f32>(smp(t, vec2<f32>(tc12.x, tc3.y)).rgb, 1.0) * (w12.x * w3.y);
+    return color.rgb / color.a;
+}
+
+// ---- utility/dithering.glsl -------------------------------------------------------------------------------------------
+
+fn bayer2(a_in: vec2<f32>) -> f32 {
+    let a = floor(a_in);
+    return fract(dot(a, vec2<f32>(0.5, a.y * 0.75)));
+}
+fn bayer4(a: vec2<f32>) -> f32 { return 0.25 * bayer2(0.5 * a) + bayer2(a); }
+fn bayer8(a: vec2<f32>) -> f32 { return 0.25 * bayer4(0.5 * a) + bayer2(a); }
+fn bayer16(a: vec2<f32>) -> f32 { return 0.25 * bayer8(0.5 * a) + bayer2(a); }
+
+fn dither_8bit(rgb: vec3<f32>, pattern: f32) -> vec3<f32> {
+    let mul_add = vec2<f32>(1.0, -0.5) / 255.0;
+    return c01v(rgb + (pattern * mul_add.x + mul_add.y));
+}
+
+// ---- utility/random.glsl, sampling.glsl -------------------------------------------------------------------------------
+
+fn r1(n: i32, seed: f32) -> f32 {
+    let alpha = 1.0 / 1.6180339887; // 1 / phi1
+    return fract(seed + f32(n) * alpha);
+}
+
+fn vogel_disc_sample(step_index: i32, step_count: i32, rotation: f32) -> vec2<f32> {
+    let golden_angle = 2.4;
+    let r = sqrt(f32(step_index) + 0.5) / sqrt(f32(step_count));
+    let theta = f32(step_index) * golden_angle + rotation;
+    return r * vec2<f32>(cos(theta), sin(theta));
+}
+
+// ---- space_conversion.glsl (y-down uv in, depth 0..1) -----------------------------------------------------------------
+
+fn screen_to_view(uv: vec2<f32>, depth: f32) -> vec3<f32> {
+    let ndc = vec3<f32>(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth);
+    let h = u.proj_inv * vec4<f32>(ndc, 1.0);
+    return h.xyz / h.w;
+}
+
+// view_to_screen_space_depth(gbufferProjection, depth): `depth` is a distance in blocks
+fn view_to_screen_space_depth(depth: f32) -> f32 {
+    let zw = -depth * vec2<f32>(u.proj[2].z, u.proj[2].w) + vec2<f32>(u.proj[3].z, u.proj[3].w);
+    return zw.x / zw.y;
+}
+
+// reproject_scene_space(): the previous frame's uv (y-down) of a scene-space position
+fn reproject_scene_space(scene_pos: vec3<f32>, hand: bool) -> vec2<f32> {
+    let camera_offset = select(u.cam.xyz - u.prev_cam.xyz, vec3<f32>(0.0), hand);
+    let previous_pos = (u.prev_mv * vec4<f32>(scene_pos + camera_offset, 1.0)).xyz;
+    let h = u.prev_proj * vec4<f32>(previous_pos, 1.0);
+    let ndc = h.xy / h.w;
+    return vec2<f32>(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
+}
+
+// ===========================================================================================================================
+//  c2_dof
+// ===========================================================================================================================
+
+@fragment
+fn fs_dof(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let texel = vec2<i32>(pos.xy);
+    let uv = pass_uv(pos);
+    let depth = fetch_depth(texel);
+
+    if (depth < HAND_DEPTH) {
+        return vec4<f32>(fetch(tex_a, texel).rgb, 1.0);
+    }
+
+    // Calculate vogel disk rotation
+    var theta = fetch(tex_noise, texel & vec2<i32>(511)).r;
+    theta = r1(i32(u.misc.y), theta);
+    theta = theta * TAU;
+
+    // Calculate circle of confusion
+    var focus = view_to_screen_space_depth(DOF_FOCUS);
+    if (DOF_FOCUS < 0.0) { focus = textureLoad(tex_c, vec2<i32>(0), 0).y; } // centerDepthSmooth
+    let coc = min(abs(depth - focus), 0.1) * (DOF_INTENSITY * 0.2 / 1.37) * vec2<f32>(1.0, u.misc.x) * u.proj[1][1];
+
+    var scene_color = vec3<f32>(0.0);
+    for (var i = 0; i < DOF_SAMPLES; i = i + 1) {
+        let offset = vogel_disc_sample(i, DOF_SAMPLES, theta);
+        scene_color = scene_color + smp(tex_a, clamp(uv + offset * coc, vec2<f32>(0.0), vec2<f32>(1.0) - 2.0 * u.res.zw)).rgb;
+    }
+    return vec4<f32>(scene_color * (1.0 / f32(DOF_SAMPLES)), 1.0);
+}
+
+// ===========================================================================================================================
+//  c4 vertex stage: auto exposure (1x1 pass) + centerDepthSmooth
+// ===========================================================================================================================
+
+fn get_bin_from_luminance(luminance: f32) -> f32 {
+    let bin_count = f32(HISTOGRAM_BINS);
+    let rcp_log_luminance_range = 1.0 / (MAX_LOG_LUMINANCE - MIN_LOG_LUMINANCE);
+    let scaled_min_log_luminance = MIN_LOG_LUMINANCE * rcp_log_luminance_range;
+    if (luminance <= MIN_LUMINANCE) { return 0.0; } // Avoid taking log of 0
+    let log_luminance = c01(log2(luminance) * rcp_log_luminance_range - scaled_min_log_luminance);
+    return min(bin_count * log_luminance, bin_count - 1.0);
+}
+
+fn get_luminance_from_bin(bin: i32) -> f32 {
+    let log_luminance_range = MAX_LOG_LUMINANCE - MIN_LOG_LUMINANCE;
+    let log_luminance = f32(bin) * (1.0 / f32(HISTOGRAM_BINS));
+    return exp2(log_luminance * log_luminance_range + MIN_LOG_LUMINANCE);
+}
+
+fn histogram_luminance() -> f32 {
+    var pdf: array<f32, 129>; // HISTOGRAM_BINS (32, 64 or 128) + 1
+    for (var i = 0; i <= HISTOGRAM_BINS; i = i + 1) { pdf[i] = 0.0; }
+
+    let tiles = vec2<i32>(32, 18);
+    let tile_size = 1.0 / vec2<f32>(tiles);
+    let lod = ceil(log2(max_of2(u.res.xy * tile_size)));
+
+    // Sample into histogram
+    for (var y = 0; y < tiles.y; y = y + 1) {
+        for (var x = 0; x < tiles.x; x = x + 1) {
+            let coord = vec2<f32>(f32(x), f32(y)) * tile_size + (0.5 * tile_size);
+            let rgb = textureSampleLevel(tex_a, samp, coord, lod).rgb;
+            let luminance = dot(rgb, LUMINANCE_WEIGHTS_AP1);
+            let bin = get_bin_from_luminance(luminance);
+            let bin0 = i32(bin);
+            let bin1 = bin0 + 1;
+            let weight1 = fract(bin);
+            let weight0 = 1.0 - weight1;
+            pdf[bin0] = pdf[bin0] + weight0;
+            pdf[bin1] = pdf[bin1] + weight1;
+        }
+    }
+
+    // Normalize PDF
+    let tile_area = tile_size.x * tile_size.y;
+    for (var i = 0; i < HISTOGRAM_BINS; i = i + 1) { pdf[i] = pdf[i] * tile_area; }
+
+    // get_median_luminance
+    var cdf = 0.0;
+    for (var i = 0; i < HISTOGRAM_BINS; i = i + 1) {
+        cdf = cdf + pdf[i];
+        if (cdf > HISTOGRAM_TARGET) { return get_luminance_from_bin(i); }
+    }
+    return 0.0; // ?? (as in the pack)
+}
+
+@fragment
+fn fs_exposure(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let prev = textureLoad(tex_c, vec2<i32>(0), 0);
+    let frame_time = u.cam.w;
+    var exposure = exp2(MANUAL_EV); // AUTO_EXPOSURE_OFF: get_exposure_from_ev_100(manual_exposure_value)
+
+    if (AUTO_EXPOSURE != 0) {
+        var previous_exposure = prev.x;
+        var luminance = 0.0;
+        if (AUTO_EXPOSURE == 1) {
+            let lod = ceil(log2(max(u.res.x, u.res.y)));
+            let rgb = textureSampleLevel(tex_a, samp, vec2<f32>(0.5), lod).rgb;
+            luminance = clamp(dot(rgb, LUMINANCE_WEIGHTS_REC2020), MIN_LUMINANCE, MAX_LUMINANCE);
+        } else {
+            luminance = histogram_luminance();
+        }
+        let target_exposure = CALIBRATION / luminance;
+        // isnan / isinf / the zero of a fresh texture: the comparison is false for NaN
+        if (!(previous_exposure > 0.0 && previous_exposure < 1e30)) { previous_exposure = target_exposure; }
+        var adjustment_rate = RATE_BRIGHT_TO_DIM;
+        if (target_exposure < previous_exposure) { adjustment_rate = RATE_DIM_TO_BRIGHT; }
+        let blend_weight = exp(-adjustment_rate * frame_time);
+        exposure = mix(target_exposure, previous_exposure, blend_weight);
+    }
+
+    // centerDepthSmooth (Iris: half-life 1 s of the depth under the crosshair)
+    let center = fetch_depth(vec2<i32>(u.res.xy * 0.5));
+    var cds = center;
+    if (prev.y > 0.0) { cds = mix(center, prev.y, exp2(-frame_time)); }
+    return vec4<f32>(exposure, cds, 0.0, 1.0);
+}
+
+// ===========================================================================================================================
+//  c4_taa_exposure
+// ===========================================================================================================================
+
+const TAA_OFFCENTER_REJECTION: f32 = 0.25; // reduces blur when moving quickly
+const TAA_VARIANCE_CLIPPING: bool = true;  // more aggressive neighborhood clipping
+
+fn min_of5(a: vec3<f32>, b: vec3<f32>, c: vec3<f32>, d: vec3<f32>, f: vec3<f32>) -> vec3<f32> {
+    return min(a, min(b, min(c, min(d, f))));
+}
+
+fn max_of5(a: vec3<f32>, b: vec3<f32>, c: vec3<f32>, d: vec3<f32>, f: vec3<f32>) -> vec3<f32> {
+    return max(a, max(b, max(c, max(d, f))));
+}
+
+// Invertible tonemapping operator (Reinhard) applied before blending the current and previous frames
+fn reinhard(rgb: vec3<f32>) -> vec3<f32> { return rgb / (rgb + 1.0); }
+fn reinhard_inverse(rgb: vec3<f32>) -> vec3<f32> { return rgb / (1.0 - rgb); }
+
+// Estimates the closest fragment in a 5x5 radius with 5 samples in a cross pattern; returns (uv, depth)
+fn get_closest_fragment(texel0: vec2<i32>) -> vec3<f32> {
+    let texel1 = texel0 + vec2<i32>(-2, -2);
+    let texel2 = texel0 + vec2<i32>(2, -2);
+    let texel3 = texel0 + vec2<i32>(-2, 2);
+    let texel4 = texel0 + vec2<i32>(2, 2);
+
+    let depth0 = fetch_depth(texel0);
+    let depth1 = fetch_depth(texel1);
+    let depth2 = fetch_depth(texel2);
+    let depth3 = fetch_depth(texel3);
+    let depth4 = fetch_depth(texel4);
+
+    var pos = select(vec3<f32>(vec2<f32>(texel1), depth1), vec3<f32>(vec2<f32>(texel0), depth0), depth0 < depth1);
+    let pos1 = select(vec3<f32>(vec2<f32>(texel3), depth3), vec3<f32>(vec2<f32>(texel2), depth2), depth2 < depth3);
+    pos = select(pos1, pos, pos.z < pos1.z);
+    pos = select(vec3<f32>(vec2<f32>(texel4), depth4), pos, pos.z < depth4);
+
+    return vec3<f32>((pos.xy + 0.5) * u.res.zw, pos.z);
+}
+
+// AABB clipping from "Temporal Reprojection Anti-Aliasing in INSIDE"; w = 1 when the history was clipped
+fn clip_aabb(history_color: vec3<f32>, min_color: vec3<f32>, max_color: vec3<f32>) -> vec4<f32> {
+    let p_clip = 0.5 * (max_color + min_color);
+    let e_clip = 0.5 * (max_color - min_color);
+    let v_clip = history_color - p_clip;
+    let v_unit = v_clip / max(e_clip, vec3<f32>(1e-3));
+    let a_unit = abs(v_unit);
+    let ma_unit = max_of3(a_unit);
+    if (ma_unit > 1.0) { return vec4<f32>(p_clip + v_clip / ma_unit, 1.0); }
+    return vec4<f32>(history_color, 0.0);
+}
+
+fn neighborhood_clipping(texel: vec2<i32>, current_color: vec3<f32>, history_in: vec3<f32>, distance_factor: f32) -> vec3<f32> {
+    // Fetch 3x3 neighborhood
+    // a b c
+    // d e f
+    // g h i
+    var a = fetch(tex_a, texel + vec2<i32>(-1, 1)).rgb;
+    var b = fetch(tex_a, texel + vec2<i32>(0, 1)).rgb;
+    var c = fetch(tex_a, texel + vec2<i32>(1, 1)).rgb;
+    var d = fetch(tex_a, texel + vec2<i32>(-1, 0)).rgb;
+    var e = current_color;
+    var f = fetch(tex_a, texel + vec2<i32>(1, 0)).rgb;
+    var g = fetch(tex_a, texel + vec2<i32>(-1, -1)).rgb;
+    var h = fetch(tex_a, texel + vec2<i32>(0, -1)).rgb;
+    var i = fetch(tex_a, texel + vec2<i32>(1, -1)).rgb;
+
+    // Convert to YCoCg (clipping in a luminance-chrominance space is superior)
+    a = rgb_to_ycocg(reinhard(a));
+    b = rgb_to_ycocg(reinhard(b));
+    c = rgb_to_ycocg(reinhard(c));
+    d = rgb_to_ycocg(reinhard(d));
+    e = rgb_to_ycocg(reinhard(e));
+    f = rgb_to_ycocg(reinhard(f));
+    g = rgb_to_ycocg(reinhard(g));
+    h = rgb_to_ycocg(reinhard(h));
+    i = rgb_to_ycocg(reinhard(i));
+
+    // Soft minimum and maximum ("Hybrid Reconstruction Antialiasing")
+    var min_color = min_of5(b, d, e, f, h);
+    min_color = min_color + min_of5(min_color, a, c, g, i);
+    min_color = min_color * 0.5;
+
+    var max_color = max_of5(b, d, e, f, h);
+    max_color = max_color + max_of5(max_color, a, c, g, i);
+    max_color = max_color * 0.5;
+
+    if (TAA_VARIANCE_CLIPPING) {
+        // Variance clipping ("An Excursion in Temporal Supersampling")
+        let m0 = (1.0 / 9.0) * (a + b + c + d + e + f + g + h + i);
+        let m1 = (1.0 / 9.0) * (a * a + b * b + c * c + d * d + e * e + f * f + g * g + h * h + i * i);
+
+        // Strictness parameter, higher gamma => more temporally stable but more ghosting
+        let gamma = mix(0.75, 1.25, linear_step(0.25, 1.0, distance_factor));
+
+        let mu = m0;
+        let sigma = sqrt(m1 - m0 * m0);
+
+        min_color = max(min_color, mu - gamma * sigma);
+        max_color = min(max_color, mu + gamma * sigma);
+    }
+
+    // Perform AABB clipping in YCoCg space
+    let history = clip_aabb(rgb_to_ycocg(history_in), min_color, max_color);
+    return ycocg_to_rgb(history.xyz);
+}
+
+@fragment
+fn fs_taa(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    let texel = vec2<i32>(pos.xy);
+    let uv = pos.xy * u.res.zw;
+    let exposure = textureLoad(tex_c, vec2<i32>(0), 0).x;
+    var result: vec4<f32>;
+
+    if (TAA_ON) {
+        let closest = get_closest_fragment(texel);
+        let closest_view = screen_to_view(closest.xy, closest.z);
+        let closest_scene = (u.mv_inv * vec4<f32>(closest_view, 1.0)).xyz; // view_to_scene_space
+        let hand = closest.z < HAND_DEPTH;
+
+        let velocity = closest.xy - reproject_scene_space(closest_scene, hand);
+        let previous_uv = uv - velocity;
+
+        var history_color = catmull_rom_fast_rgb(tex_b, previous_uv, 0.6);
+        history_color = max0v(history_color); // Eliminate NaNs in the history
+
+        var pixel_age = fetch(tex_b, vec2<i32>(previous_uv * u.res.xy)).a;
+        let inside = all(c01v2(previous_uv) == previous_uv);
+        pixel_age = max0(pixel_age * select(0.0, 1.0, inside) + 1.0);
+
+        // Distance factor to favour responsiveness closer to the camera and image stability further away
+        let distance_factor = 1.0 - exp2(-0.025 * length(closest_view));
+
+        // Dynamic blend weight lending equal weight to all frames in the history
+        let blend_weight = mix(0.35, 0.10, distance_factor);
+        var alpha = max(1.0 / pixel_age, blend_weight);
+
+        // Native resolution TAA
+        var current_color = fetch(tex_a, texel).rgb;
+
+        // "Tonemapping" before applying TAA in order to perform the AA in SDR
+        current_color = reinhard(current_color);
+        history_color = reinhard(history_color);
+
+        history_color = neighborhood_clipping(texel, current_color, history_color, distance_factor);
+
+        // Offcenter rejection from Jessie, which is originally by Zombye; reduces blur in motion
+        let pixel_offset = 1.0 - abs(2.0 * fract(u.res.xy * previous_uv) - 1.0);
+        let offcenter_rejection = sqrt(pixel_offset.x * pixel_offset.y) * TAA_OFFCENTER_REJECTION + (1.0 - TAA_OFFCENTER_REJECTION);
+
+        alpha = 1.0 - alpha;
+        alpha = alpha * offcenter_rejection;
+        alpha = 1.0 - alpha;
+
+        current_color = mix(history_color, current_color, alpha);
+        current_color = reinhard_inverse(current_color);
+
+        result = vec4<f32>(current_color, pixel_age * offcenter_rejection);
+    } else {
+        result = fetch(tex_a, texel);
+    }
+
+    // Store exposure in the alpha component of the corner texel of the history buffer
+    if (texel.x == 0 && texel.y == 0) { result.a = exposure; }
+
+    return result;
+}
