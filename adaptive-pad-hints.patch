+    /// The box `b` (x0, y0, x1, y1) is at least `clear` px from the rect `a` (x, y, w, h).
+    fn apart(b: [f32; 4], a: [f32; 4], clear: f32) -> bool {
+        b[0] >= a[0] + a[2] + clear || b[2] <= a[0] - clear || b[1] >= a[1] + a[3] + clear || b[3] <= a[1] - clear
+    }
