+float cloud_noise(vec2 p) {
+    ivec2 c = ivec2(floor(p));
+    vec2 f = fract(p);
+    vec2 u = f * f * (3.0 - 2.0 * f);
+    float a = mix(cloud_hash(c), cloud_hash(c + ivec2(1, 0)), u.x);
+    float b = mix(cloud_hash(c + ivec2(0, 1)), cloud_hash(c + ivec2(1, 1)), u.x);
