+bool cloud_filled(ivec2 c) {
+    vec2 p = vec2(c);
+    return 0.65 * cloud_noise(p * 0.2) + 0.35 * cloud_noise(p * 0.55 + vec2(31.0, 17.0)) > cloudp.x;
