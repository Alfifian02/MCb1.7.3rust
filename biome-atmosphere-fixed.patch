+vec2 cloud_march(vec3 ro, vec3 rd) {
+    float y0 = cloudp.y;
+    float y1 = y0 + 4.0;
+    if (rd.y < 0.01 || ro.y > y1) { return vec2(0.0); }
+    float t_end = (y1 - ro.y) / rd.y;
