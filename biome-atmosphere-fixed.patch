+const H: usize = 3; // horizon = fog, day colour (3)
+const HZ: usize = 6; // haze band colour (3)
+const HA: usize = 9; // haze band strength 0..1
+const DENS: usize = 10; // exp² fog density, per block
+const CL: usize = 11; // cloud tint (3)
