+                    let (lo, hi) = ((v * 100.0 + 155.0) as i32 as u8, (v * v * v * v * 255.0) as i32 as u8);
+                    t[i..i + 4].copy_from_slice(&[(v * v * 200.0 + 55.0) as i32 as u8, hi, lo, lo]);
